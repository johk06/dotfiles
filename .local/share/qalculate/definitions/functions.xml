<?xml version="1.0"?>
<QALCULATE version="5.8.2">
    <function>
        <names>basisvec</names>
        <expression>\x/norm(\x)</expression>
    </function>
    <function>
        <names>trace</names>
        <argument type="matrix" index="1">
            <title>matrix</title>
            <condition>
                columns(\x) == rows(\x)
            </condition>
        </argument>
        <expression>
            sum(element(\x, n, n), 1, rows(\x), n)
        </expression>
    </function>
</QALCULATE>
