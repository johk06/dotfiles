address "chat.sr.ht"
nickname "johhk"
username "johhk"
password-cmd pass-get "social/irc/bouncer" sourcehut-token

# uses harper ls
spell-check true
colors {
    prompt 15
    status 15
    nicks base
    nicks self teal
}

pane-widths {
    nicknames 8
    channels 12
    members 12
}
