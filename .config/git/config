[user]
email = jhk06@mailbox.org
name = jhk

[core]
# Don't hard-wrap long lines
pager = "less -+S"

[include]
path = ./aliases

[grep]
heading = true
lineNumber = true

[diff]
context = 8
renames = copy
tool = nvimdiff

[difftool]
prompt = false
trustExitCode = true

[init]
defaultbranch = main

[interactive]
singleKey = true

[color "interactive"]
prompt = italic cyan
help = italic white

[color "diff"]
meta = brightblue
frag = bold brightmagenta
func = bold white

[color "grep"]
filename = cyan
match = bold yellow
lineNumber = magenta
separator = brightblack
selected = white # otherwise git produces brightwhite

[color "status"]
updated = green
changed = yellow
added = bold yellow
untracked = brightblack

[color "decorate"]
HEAD = cyan
branch = green
remoteBranch = italic blue
tag = red

; Allow it to override anything else
[includeIf "gitdir:~/ws/uni/**"]
path = ./uni
