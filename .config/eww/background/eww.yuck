(defwindow background
    :monitor '["DP-1", "eDP-1", 0]'
    :geometry (geometry
        :width "1px"
        :height "100%"
        :anchor "left center")
    :stacking "bg"
    :focusable "ondemand"
    :namespace "eww-background"
    (background-window))

(defvar background-transparent true)
(defwidget background-window []
    (box :hexpand true :vexpand true :space-evenly false :orientation "v" :class "background-widgets"
        (box :space-evenly false :hexpand true :vexpand true :orientation "v"
            :spacing 40
            :class "background-content${background-transparent ? "" :"-opaque"}"
            (background-clock)
            (background-calendar)
            (background-poem))
        (box 
            (background-controls))))
 
(defwidget background-clock []
    (box :orientation "v" :space-evenly false :class "background-clock"
        (box :space-evenly false
            (label :text {formattime(EWW_TIME, "%H:%M")} :class "background-time")
            (box :hexpand true :halign "end" (circular-progress
                :class "background-timer"
                :thickness 6
                :value {(EWW_TIME % 60) / 0.6}
                :clockwise true
                :start-at 75
                (button
                    :onclick "${EWW_CMD} update background-transparent=${!background-transparent}"
                    {formattime(EWW_TIME, ":%S")}))))
        (box :halign "start" (label :text {formattime(EWW_TIME, "%d. %B, %A")} :class "background-date"))))


(defwidget background-calendar []
    (box :class "background-calendar-box" :orientation "v" :space-evenly false
        (calendar :class "background-calendar")))

(defvar poem-author "")
(defvar poem-title "")
(defpoll poem-of-the-day :interval "60m" "bin/poem.sh")
(defvar update-poem 'eww update poem-of-the-day="$(bin/poem.sh)"')
(defwidget background-poem []
    (box :class "poem-content" :space-evenly false :hexpand true :vexpand true
        (scroll :style "min-height: 40rem" :hexpand true :vexpand true
            (box :orientation "v" :hexpand true :space-evenly false
                (label :wrap true :justify "center" :class "poem-title"
                    :text "${poem-of-the-day.title} 
by ${poem-of-the-day.author}")
                (hsep :height 20)
                (label :wrap true :justify "center" :class "poem-text"
                    :text {jq(poem-of-the-day.lines, 'join("\\n")')})))))

(defwidget background-controls []
    (box :space-evenly false :class "background-controls" :hexpand true :vexpand true :orientation "v"
        (box :space-evenly false :halign "center"
            (input :class "input"
                :onchange `${EWW_CMD} update poem-title='{}'`)
            (label :text "by" :class "poem-by")
            (input :class "input"
                :onchange `${EWW_CMD} update poem-author='{}'`)
            (button :timeout "128s" :onclick {update-poem} :class "button active" "Get Poem"))))
