; My desktop shell
(include "widgets/icon.yuck")

; Pseudo-constants
(defpoll HOME :interval "200h" 'echo "$HOME"')
(defpoll HOSTNAME :interval "200h" 'hostname')
(defpoll USER :interval "200h" 'whoami')
(defpoll BOOTTIME :interval "200h" "awk '/btime/ {print $2}' /proc/stat")

(defwidget hsep [height]
    (box :class "hsep" :style "margin-top: ${height / 2}; margin-bottom: ${height / 2}"))
(defwidget vsep [width]
    (box :class "hsep" :style "margin-left: ${width / 2}; margin-right: ${width / 2}"))

(include "menu/menu.yuck")
(include "bar/bar.yuck")
