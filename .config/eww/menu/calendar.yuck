(include "menu/weather.yuck")

(defpoll todo-active :interval "30m" "todo --porcelain list | jq 'sort_by(.start//.due//infinite)'")
(defpoll todo-done :interval "30m" "todo --porcelain list --sort=completed_at --status=COMPLETED")

(defvar todo-reload "eww update todo-reloading=true;eww poll todo-active todo-done;eww update todo-reloading=false")

(defpoll _todo-day :interval "100000m" "date +%d")
(defpoll _todo-month :interval "100000m" "date +%m")
(defpoll _todo-year :interval "100000m" "date +%Y")

(defvar todo-date "")

(defwidget agenda-section []
    (box :orientation "v" :space-evenly false :vexpand true
        (agenda-calendar-section)
        (agenda-list-section)))

(defwidget agenda-calendar-section []
    (box :orientation "h" :class "agenda-calendar-section" :valign "center" :space-evenly false
        (box :class "calendar-box" :hexpand true (calendar :class "agenda-calendar"
            :day {_todo-day}
            :month {_todo-month}
            :year {_todo-year}
            :timeout "600s"
            :onclick "${EWW_CMD} update todo-date={2}-$(({1}+1))-{0}"))
        (rounded-image :path "${HOME}/.config/background/thumb" :width "160px")))

(defwidget todo-date [time if-none ?no-hl ?start]
    (box :space-evenly false
        (button :class "sbutton ${(time == "null" || (no-hl?:false)) ? "" : (time - EWW_TIME < 0 ? 
            (start?:false ? "current" : "alert") : (
            time - EWW_TIME < 86400 ? "warn" :  ; next day
            time - EWW_TIME < 345600 ? "info" : "" ; next half-ish week
        ))}"
            :timeout "128s"
            :onclick "${EWW_CMD} update ${formattime(time, "_todo-day=%d _todo-month=%m _todo-year=%Y")}"
            :tooltip {time != "null" ? formattime(time, "%H:%M on %a, %d %b") : if-none}
            (label
                :class "${time == "null" ? "hidden" : ""}"
                :text "${time != "null" ? formattime(time, "%a, %d %b") : if-none}"))))

(defvar agenda-expanded-todo 0)
(defvar agenda-selected-list 0)
(defwidget agenda-list-section []
    (box :orientation "v" :space-evenly false :class "agenda-list-section" :vexpand true
        (agenda-list-controls)
        (stack :selected {agenda-selected-list} :tramsition "slideright" :same-size true :vexpand true
            (agenda-todo-list)
            (agenda-weather-list))))

(defvar agenda-show-done false)
(defwidget agenda-todo-list []
    (box :orientation "v" :space-evenly false
        (agenda-todo-new)
        (scroll :vscroll true :vexpand true
            (box :orientation "v" :space-evenly false
                (box :orientation "v" :space-evenly false
                    (for item in todo-active
                        (todo-task :item item)))
                (box :space-evenly false :hexpand true
                    (button :class "text-button" :style "margin-top: 1.4rem;"
                        :onclick "${EWW_CMD} update agenda-show-done=${!agenda-show-done}"
                        {agenda-show-done ? "" : ""})
                    (box :halign "center"
                        (label :class "agenda-heading" :text "Completed")))
                (revealer :reveal {agenda-show-done} :transition "slidedown"
                    (box :orientation "v" :space-evenly false
                        (hsep :height 20)
                        (for item in todo-done
                            (todo-done-task :item item))))))))

(defwidget todo-level-editor [level id] (box :valign "center" :style "padding: .6rem;"
    (box :space-evenly false
        (button :class "button tiny-circle ${level != 0 && level <= 4 ? "red" : ""}"
            :timeout "256s"
            :onrightclick "todo edit ${id} --priority=none; ${todo-reload}"
            :onclick "todo edit ${id} --priority=high; ${todo-reload}")
        (button :class "button tiny-circle ${level > 4 && level <= 7 ? "yellow" : ""}"
            :timeout "256s"
            :onrightclick "todo edit ${id} --priority=none; ${todo-reload}"
            :onclick "todo edit ${id} --priority=medium; ${todo-reload}")
        (button :class "button tiny-circle ${level > 7 && level <= 10 ? "green" : ""}"
            :timeout "256s"
            :onrightclick "todo edit ${id} --priority=none; ${todo-reload}"
            :onclick "todo edit ${id} --priority=low; ${todo-reload}"))))

(defwidget todo-task [item]
    (box :class "todo-task" :orientation "v" :space-evenly false
        (box :space-evenly false
            (button :class "button"
                :onclick "${EWW_CMD} update agenda-expanded-todo=${agenda-expanded-todo == item.id ? 0 : item.id}"
                {agenda-expanded-todo == item.id ? "" : "" })
            (box :hexpand true :halign "start"
                (button :tooltip {item.summary} :class "todo-title"
                    :timeout "128s"
                    :onclick "todo done ${item.id}; ${todo-reload}"
                    (label :text {item.summary} :limit-width 20)))
            (todo-date :time {item.start} :if-none "No Start" :start true)
            (todo-date :time {item.due} :if-none "No Due Date"))
        (revealer :reveal {item.id == agenda-expanded-todo} :transition "slidedown"
            (box :orientation "v" :space-evenly false
                (todo-level-editor :level {item.priority} :id {item.id})
                (input :class "input"
                    :value {item.description}
                    :timeout "128s"
                    :onaccept `echo -n '{}' | todo edit -r ${item.id}; ${todo-reload}`)
                (box :space-evenly false
                    (button :class "sbutton alert-on-hover"
                        :timeout "128s"
                        :onclick "todo delete --yes ${item.id}; ${todo-reload}"
                        "󰆴   Delete")
                    (box :space-evenly false :hexpand true)
                    (button :class "sbutton"
                        :timeout "128s"
                        :onclick "todo edit ${item.id} -s '${agenda-new-start}'; ${todo-reload}"
                        :onrightclick `sed '/^DTSTART:/d' -i "$(todo path ${item.id})"; ${todo-reload}`
                        "Change Start")
                    (button :class "sbutton"
                        :timeout "128s"
                        :onclick "todo edit ${item.id} -d '${agenda-new-due}'; ${todo-reload}"
                        :onrightclick `sed '/^DUE:/d' -i "$(todo path ${item.id})"; ${todo-reload}`
                        "Change Due"))))))

(defwidget todo-done-task [item]
    (box :class "todo-task" :orientation "v" :space-evenly false
        (box :space-evenly false
            (button :class "button" :timeout "128s"
                :onclick `sed -e 's/^STATUS:COMPLETED/STATUS:NEEDS-ACTION/' -e '/^COMPLETED:/d' -e '/^PERCENT-COMPLETE/d' -i "$(todo path ${item.id})";${todo-reload}`
                "󰕌")
            (box :hexpand true :halign "start" :style "margin-left: .5rem;"
                (label :class "todo-title" :text {item.summary} :limit-width 20))
            (button :class "sbutton alert-on-hover" :timeout "128s"
                :onclick "todo delete --yes ${item.id};${todo-reload}" "󰆴")
            (todo-date :time {item.completed_at} :if-none "Nope" :no-hl true))))

(defvar agenda-new-text "")
(defvar agenda-new-start "")
(defvar agenda-new-due "")
(defwidget agenda-todo-new []
    (box :class "agenda-control" :space-evenly false :orientation "v"
        (box :space-evenly false
            (button
                :class "sbutton active"
                :timeout "128s"
                :onclick "todo new -l Tasks -d '${agenda-new-due}' -s '${agenda-new-start}' '${agenda-new-text}'; ${todo-reload}"
                "Add")
            (input :class "input l1"
                :value {todo-date}
                :onchange "${EWW_CMD} update agenda-new-start='{}'")
            (input :class "input l1"
                :value {todo-date}
                :onchange "${EWW_CMD} update agenda-new-due='{}'"))
        (box :space-evenly false :hexpand true
            (input :class "input l1" :hexpand true
                :onaccept "todo new -l Tasks -d '${agenda-new-due}' -s '${agenda-new-start}' '${agenda-new-text}'; ${todo-reload}"
                :timeout "128s"
                :onchange "${EWW_CMD} update agenda-new-text='{}'"))))

(defvar todo-syncing false)
(defvar todo-reloading false)
(defwidget agenda-list-controls []
    (box :space-evenly false :hexpand true
        (box :space-evenly false
            (button :class "button ${agenda-selected-list == 0 ? "active" : ""}"
                :onclick "${EWW_CMD} update agenda-selected-list=0"
                "Agenda")
            (button :class "button ${agenda-selected-list == 1 ? "active" : ""}"
                :onclick "${EWW_CMD} update agenda-selected-list=1"
                "Weather"))
        (box :halign "end" :hexpand true  :space-evenly false
            (button :class "button"
                :timeout "356s"
                :onclick `${EWW_CMD} update ${formattime(EWW_TIME, "_todo-day=%d _todo-month=%m _todo-year=%Y")}`
                "Today")
            (button :class "button ${todo-reloading ? "active" :""}"
                :timeout "356s"
                :onclick "${todo-reload}"
                {todo-syncing ? "Reload..." : "Reload"})
            (button :class "button ${todo-syncing ? "active" :""}"
                :timeout "356s"
                :onclick "${EWW_CMD} update todo-syncing=true;pimsync sync; ${todo-reload};${EWW_CMD} update todo-syncing=false"
                {todo-syncing ? "Sync..." : "Sync"}) )))
