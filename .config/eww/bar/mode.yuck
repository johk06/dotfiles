(defvar mode-names '{
"default": "Normal",
"media": "Media",
"screenshot": "Print",
"clipboard":"Yank",
"config":"Config",
"insert": "Insert"
}')

(defvar mode-descs '{
"default": [ ],
"media": [
    {"keys": "M-*", "action": "Mic", "mod": true },
    {"keys": "jk 0-9", "action": "Volume"},
    {"keys": "mM", "action": "Mute"},
    {"keys": "nN", "action": "Device"},
    {"keys": "M-*", "action": "Other", "mod": true },
    {"keys": "tT", "action": "Target"},
    {"keys": "shl", "action": "Seek"},
    {"keys": "fb", "action": "Track"},
    {"keys": "r", "action": "Repeat"},
    {"keys": "z", "action": "Shuffle"},
    {"keys": "q", "action": "Queue"},
    {"keys": "p", "action": "Play"}
],
"screenshot": [
    {"keys": "C-*", "action": "To Disk", "mod": true },
    {"keys": "S-*", "action": "Video", "mod": true },
    {"keys": "s", "action": "Screen" },
    {"keys": "v", "action": "Visual" },
    {"keys": "w", "action": "Window" },
    {"keys": "c", "action": "Color"},
    {"keys": "q", "action": "QR-Code"},
    {"keys": "t", "action": "Text"}
],
"config": [
    {"keys": "jk", "action": "Brightness"},
    {"keys": "nN", "action": "Nighlight"},
    {"keys": "g", "action": "Gaps"},
    {"keys": "bB", "action": "Border"},
    {"keys": "-+", "action": "Opacity"},
    {"keys": "m", "action": "Mirror Screen"},
    {"keys": "t", "action": "Theme"},
    {"keys": "w", "action": "Wallpaper"},
    {"keys": "r", "action": "Random"},
    {"keys": "p", "action": "Clear Passwords"}
],
"clipboard": [
    {"keys": "M-*", "action": "Sel-", "mod": true},
    {"keys": "p", "action": "Print"},
    {"keys": "y", "action": "Copy"},
    {"keys": "a", "action": "Append"},
    {"keys": "i", "action": "Prepend"},
    {"keys": "x", "action": "Exchange"},
    {"keys": "e", "action": "Edit"},
    {"keys": "mo", "action": "Open"},
    {"keys": "c", "action": "Clear"},
    {"keys": "t", "action": "Translate"}
],
"insert": [
    {"keys": "(M-)y", "action": "Clipboard"},
    {"keys": "dD", "action": "Date"},
    {"keys": "tT", "action": "Time"},
    {"keys": "p", "action": "Password"},
    {"keys": "sS", "action": "Speech"}
]}')

(deflisten mode
    :initial '{"change": "default"}'
    'swaymsg -t subscribe \'["mode"]\' -m')

(defwidget mode-hints []
    (revealer :reveal {mode.change != "default"} 
        :transition "slideleft" :duration "200ms"
        (box :space-evenly false
            (for desc in {mode-descs[mode.change]}
                (box :space-evenly false :class "mode-box"
                    (label :text "${desc.keys}" :class {desc.mod?:false ? "mode-mod" : "mode-keys"})
                    (label :text "${desc.action}" :class "mode-action"))))))

(defwidget mode-symbol []
    (box :space-evenly false
        (button 
            :onclick "swaymsg mode default"
            :class "mode-${mode.change}"
            "${mode-names[mode.change]}")))
