(defvar ws-overview-reveal false)
;; clean upscale of 16:9 see workspace.scss
(defvar overview-ws-width 192)
(defvar overview-ws-height 108)

(defwidget ws-win [win ws]
    (box :style "
        margin-left: ${round(win.rect.x * overview-ws-width, 0)}px;
        margin-top: ${round(win.rect.y * overview-ws-height, 0)}px;
        margin-right: -${round((win.rect.x + win.rect.width) * overview-ws-width, 0)}px;
        margin-bottom: -${round((win.rect.y + win.rect.height) * overview-ws-height, 0)}px;
        "
        :class "overview-window${win.focused ? " active" : ""} ${win.float ? "float" : ""}"
        :hexpand false
        :vexpand false
        :halign "start"
        :valign "start"
        (eventbox :tooltip "${win.name}"
            :onclick "swaymsg [con_id=${win.id}] focus >/dev/null&"
            :onrightclick "swaymsg [con_id=${win.id}] move window to scratchpad >/dev/null&"
            (image
                :path {win.icon}
                :valign "center"
                :halign "center"
                :image-width {round(win.rect.width * overview-ws-width / 3, 0)}
                :image-height {round(win.rect.height * overview-ws-height / 3, 0)}))))

(defwidget ws-box [ws]
    (box :class "workspace ${ws.focused ? "active" : ""}"
        (eventbox
            :onclick "swaymsg workspace ${ws.ws} >/dev/null"
            (box :orientation "vertical" :space-evenly false
                (box :space-evenly false :vexpand true (for win in {ws.wins} (ws-win :win win :ws {ws.ws})))
                (box :halign "start" :valign "end"
                    (label :class "workspace-name" :text {ws.icon}))))))

(defwidget ws-overview-scratch []
    (stack :selected {sway.scratch_count > 0 ? 1 : 0}
        :width overview-ws-width :height overview-ws-height
        (box (label :class "text faint" :text "Scratch Empty"))
        (box (scroll :vexpand true :vscroll true (box :orientation "v"
            :space-evenly false
            :style "padding: .5rem;"
            :valign "start"
            (for win in {sway.scratch}
                (button :class "overview-scratch" :tooltip {win.name}
                    :onclick "swaymsg '[con_id=${win.id}]' scratchpad show >/dev/null"
                    (box :space-evenly false
                        (image
                            :style "margin-right: .4rem; margin-left: .4rem;"
                            :path {win.icon}
                            :image-width 16 :image-height 16)
                        (label :limit-width 16
                            :class "text" :text {win.name})))))))))

(defwidget ws-overview []
    (eventbox
        :onhoverlost "./bin/popup.sh ws-overview-win ws-overview-reveal close&"
        (revealer
            :reveal {ws-overview-reveal}
            :transition "slidedown"
            (box (box :class "popup-win" :space-evenly false
                (ws-overview-scratch)
                (box
                    (for ws in {sway.workspaces}
                        (ws-box :ws {ws}))))))))

(defwindow ws-overview-win
    :monitor '["DP-1", "eDP-1", 0]'
    :geometry (geometry
        :x 0
        :y -50
        :width 0
        :height 0
        :anchor "top center")
    :stacking "overlay"
    :exclusive false
    (ws-overview))
