(deflisten marks 'bin/marks.sh')

(defwidget mark-list [] (box :space-evenly false (for mark in marks
    (button
        :class "mark ${sway.active != "null" && sway.active.marks[0] == mark ? "active" : ""}"
        :style "transition: none;"
        :onclick `swaymsg '[con_mark=${mark}] focus'`
        "'${mark}"))))
