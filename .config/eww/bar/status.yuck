(defvar recording false)
(defvar recording-info '{
    "start": 0,
    "pid": 0,
    "path": ""
}')
(defvar bat-discharging '[
    "󰂎",
    "󰁺",
    "󰁻",
    "󰁼",
    "󰁽",
    "󰁾",
    "󰁿",
    "󰂀",
    "󰂁",
    "󰂂",
    "󰁹"
]' )
(defvar bat-charging '[
    "󰢟",
    "󰢜",
    "󰂆",
    "󰂇",
    "󰂈",
    "󰢝",
    "󰂉",
    "󰢞",
    "󰂊",
    "󰂋",
    "󰂅"
]' )

;; see /usr/include/libupower-glib/up-types.h
(defvar bat-types '[
    "",
    "",
    "",
    "",
    "󰍹 ",
    "󰍿 ",
    "󰌌 ",
    "",
    " ",
    "󰥠 ",
    "󰏭 ",
    "",
    "󰊴 ",
    "󰏪 ",
    "󰓶 ",
    "",
    "",
    "󰋋 ",
    "󰓃 ",
    "󰋋 ",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "󰂯 "
]')

(deflisten batteries "bin/batteries.sh")

(defwidget status-valent [dev]
    (button
        :class "tiny-button ${dev != "" ? "" : "inactive"}"
        :tooltip {dev != "" ?
            "Connected to ${dev.name}, ${dev?.battery?.percentage}% - ${dev.battery.charging ? "Charging" : "Discharging"}"
            : "No Devices Connected"}
        :onclick `${valent-call} ${dev.path} org.gtk.Actions Activate 'sava{sv}' share.text 1 s "$(wl-paste)" 0`
        :onrightclick `${valent-call} ${dev.path} org.gtk.Actions Activate 'sava{sv}' share.uri 1 s "$(wl-paste)" 0`
        ""))

(defwidget status-batteries []
    (box :space-evenly false :spacing 12 :style "margin-left: .5rem;"
        (for dev in {batteries}
            (label
                :class {dev.charging ? "" : (dev.value < 20 ? "red" : "")}
                :tooltip "${dev.name}: ${dev.value}%${dev.to_empty != "null" ? "
${formattime(dev.to_empty, "%H:%M left")}" : ""}${dev.to_full != "null" ? "
${formattime(dev.to_full, "%H:%M until full")}" : ""}${dev.rate != "null" ? "
${dev.rate}W" : ""}"
                :text
                    "${bat-types[dev.type]}${dev.charging
                    ? (bat-charging[(dev.value - dev.value % 10)/10])
                    : (bat-discharging[(dev.value - dev.value % 10)/10])}${dev.internal ? "   ${dev.value}%": ""}"))))

(defvar numen-state "off") ;; off | suspended | listening
(defwidget status-numen []
    (button
        :class "tiny-button ${numen-state == "listening" ? "active" : (numen-state == "off" ? "inactive" : "" )}"
        :onclick "~/.config/sway/scripts/toggle-numen" :timeout "128s"
        :tooltip "Numen is ${numen-state}"
        :onrightclick "~/.config/sway/scripts/toggle-numen kill"
        {numen-state == "listening" ? "" : "󰩅"}))
(defwidget status-service-toggle [running to-kill cmd var symbols ?tooltip]
    (button :class "tiny-button ${running ? "" : "inactive"}"
        :timeout "16s"
        :tooltip {tooltip}
        :onclick "killall ${to-kill} && ${EWW_CMD} update ${var}=false || { ${EWW_CMD} update ${var}=true; ${cmd}& }"
        {running ? symbols[1] : symbols[0]}))
(defwidget status-settings [] (box :spacing 8
    (button :class "tiny-button ${service-swayidle ? "" : "inactive"}"
        :style "padding-right: .2rem;"
        :timeout "16s"
        :onclick "killall swayidle && ${EWW_CMD} update service-swayidle=false || { ${EWW_CMD} update service-swayidle=true; swayidle -w& }"
        {service-swayidle ? "󰒲" : ""})))
(defwidget status-audio [] (box :spacing 8
    (button
        :class "tiny-button ${audio.out.mute ? "inactive" : (center-popup-reveal && center-popup-layer == 0 && audio-popup-kind == "out" ? "active" : "")}"
        :onclick "pamixer -t"
        :tooltip "${audio.out.name}: ${audio.out.vol}%"
        {audio.out.mute ? "󰸈" : (audio.out.vol > 70 ? "󰕾" : (audio.out.vol > 20 ? "󰖀" : "󰕿"))})
    (button
        :class "tiny-button ${audio.in.mute ? "inactive" : (center-popup-reveal && center-popup-layer == 0 && audio-popup-kind == "in" ? "active" : "")}"
        :onclick "pamixer -t --default-source"
        :tooltip "${audio.in.name}: ${audio.in.vol}%"
        {audio.in.mute ? "󰍭" : "󰍬"})))
(defwidget status-network [] (box :spacing 8
    (button
        :class "tiny-button ${vpn.active ? "" : "inactive"}"
        :onclick {vpn.active ? "nmcli connection down '${vpn.name}'" : "nmcli connection up '${default-vpn}'"}
        :tooltip "${vpn.active ? "Connected via `${vpn.name}`" : "No VPN active"}"
        "󰒄")
    (label
        :class {!wifi.powered ? "inactive" : ""}
        :tooltip {wifi.connected ? "Connected to ${wifi.ssid}" : "No Connection"}
        :text {wifi.connected ? (wifi.signal > 80 ? "󰤨"
            : (wifi.signal > 60 ? "󰤥"
                : (wifi.signal > 40 ? "󰤢"
                    : (wifi.signal > 20 ? "󰤟" : "󰤯")))) : (wifi.powered  ? "󰤫" : "󰤮")})))
(defwidget status-brightness []
    (label :class "tiny-button ${center-popup-reveal && center-popup-layer == 1 ? "active" : (brightness < 40 ? "inactive" : "")}"
        :tooltip "Screen Brightness: ${brightness}%"
        :text {brightness < 10 ? "󰃛"
            : (brightness < 20 ? "󰃜"
            : (brightness < 40 ? "󰃝"
            : (brightness < 60 ? "󰃞"
            : (brightness < 80 ? "󰃟"
            : "󰃠"))))}))
(defwidget status-recording []
    (revealer :reveal recording :transition "slideright" :visible recording
        (button :class "tiny-button red"
            :onclick "kill ${recording-info.pid}"
            :tooltip "Recording to ${recording-info.path}"
            (box :space-evenly false
                (label :text "󰄉" :style "min-width: .8rem;" :xalign 1) 
                (label :style "min-width: 3.6rem;" :xalign 1
                    :text "${formattime(EWW_TIME - recording-info.start, "%M:%S", "UTC")}")))))

(defwidget status []
    (box :class "button" :space-evenly false :spacing 8
        (status-audio)
        (label
            :class {!bt-meta.powered ? "inactive" : ""}
            :text {bt-meta.powered ? "󰂯" : "󰂲"})
        (status-valent :dev {valent.connected?.[0] ?: ""})
        (status-network)
        (status-batteries)
        (status-settings)
        (status-numen)
        (status-brightness)
        (status-recording)))
