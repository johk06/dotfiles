(defvar recording false)
(defvar recording-info '{
    "start": 0,
    "pid": 0,
    "path": ""
}')
(defvar bat-discharging '[
    "󰂎",
    "󰁺",
    "󰁻",
    "󰁼",
    "󰁽",
    "󰁾",
    "󰁿",
    "󰂀",
    "󰂁",
    "󰂂",
    "󰁹"
]' )
(defvar bat-charging '[
    "󰢟",
    "󰢜",
    "󰂆",
    "󰂇",
    "󰂈",
    "󰢝",
    "󰂉",
    "󰢞",
    "󰂊",
    "󰂋",
    "󰂅"
]' )

;; see /usr/include/libupower-glib/up-types.h
(defvar bat-types '[
    "",
    "",
    "",
    "",
    "󰍹 ",
    "󰍿 ",
    "󰌌 ",
    "",
    " ",
    "󰥠 ",
    "󰏭 ",
    "",
    "󰊴 ",
    "󰏪 ",
    "󰓶 ",
    "",
    "",
    "󰋋 ",
    "󰓃 ",
    "󰋋 ",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "󰂯 "
]')

(deflisten batteries "bin/batteries.sh")

(defwidget status-batteries []
    (box :space-evenly false
        (for dev in {batteries}
            (button
                :class "status-text ${dev.charging ? "recharging" : (dev.value < 20 ? "alert" : "")}"
                :tooltip "${dev.name}: ${dev.value}%${dev.to_empty != "null" ? "
${formattime(dev.to_empty, "%H:%M left", "UTC")}" : ""}${dev.to_full != "null" ? "
${formattime(dev.to_full, "%H:%M until full", "UTC")}" : ""}${dev.rate != "null" ? "
${dev.rate}W" : ""}"
                "${bat-types[dev.type]}${dev.charging
                    ? (bat-charging[(dev.value - dev.value % 10)/10])
                    : (bat-discharging[(dev.value - dev.value % 10)/10])}${dev.internal ? "   ${dev.value}%": ""}"))))

(defvar numen-state "off") ;; off | suspended | listening

(defwidget status-audio [] (box :space-evenly false
    (button
        :class "status-text ${audio.out.mute ? "inactive" : (center-popup-reveal && center-popup-layer == 0 && audio-popup-kind == "out" ? "active" : "")}"
        :onclick "pamixer -t"
        :onrightclick "pamixer -t --default-source"
        :tooltip "${audio.out.name}: ${audio.out.vol}%"
        (box :space-evenly false
            (label :xalign -1
                :style "min-width: 3em;"
                :text
                "${audio.out.mute ? "󰸈" : (audio.out.vol > 70 ? "󰕾" : (audio.out.vol > 20 ? "󰖀" : "󰕿"))} ${audio.out.vol}%")
            (label :class "status-text small ${audio.in.mute ? "inactive" : ""}"
                :text {audio.in.mute ? "󰍭" : "󰍬"}) ))))

(defwidget status-network []
    (button :class "status-text ${vpn.active ? "" : "inactive"}"
        :onclick {vpn.active ? "nmcli connection down '${vpn.name}'" : "nmcli connection up '${default-vpn}'"}
        :tooltip "${vpn.active ? "Connected via `${vpn.name}`" : "No VPN active"}"
        (box :space-evenly false
            {vpn.active ? "󰒄" : "󰲝"}
            (label
                :class "status-text ${!wifi.powered ? "inactive" : ""}"
                :tooltip {wifi.connected ? "Connected to ${wifi.ssid}" : "No Connection"}
                :text "  ${wifi.connected ? (wifi.signal > 80 ? "󰤨"
                    : (wifi.signal > 60 ? "󰤥"
                        : (wifi.signal > 40 ? "󰤢"
                            : (wifi.signal > 20 ? "󰤟" : "󰤯")))) : (wifi.powered  ? "󰤫" : "󰤮")}")
            (label
                :class "status-text ${!bt-meta.powered ? "inactive" : ""} small"
                :text {bt-meta.powered ? "󰂯" : "󰂲"}))))

(defwidget status-brightness []
    (label :class "status-text small"
        :tooltip "Screen Brightness: ${brightness}%"
        :text "${brightness < 10 ? "󰃛"
            : (brightness < 20 ? "󰃜"
            : (brightness < 40 ? "󰃝"
            : (brightness < 60 ? "󰃞"
            : (brightness < 80 ? "󰃟"
            : "󰃠"))))}"))

(defwidget status-settings []
    (button
        :class "status-text ${service-swayidle ? "" : "inactive"} ${center-popup-reveal && center-popup-layer == 1 ? "active" : ""}"
        :timeout "16s"
        :onclick "killall swayidle && ${EWW_CMD} update service-swayidle=false || { ${EWW_CMD} update service-swayidle=true; swayidle -w& }"
        (box :space-evenly false
            (label :text {service-swayidle ? "󰒲 " : "󰒳 "})
            (status-brightness))))

(defwidget status-recording []
    (revealer :reveal recording :transition "slideright" :visible recording
        (button :class "status-text alert" :style "margin-left: 1rem;"
            :onclick "kill ${recording-info.pid}"
            :tooltip "Recording to ${recording-info.path}"
            (box :space-evenly false
                (label :text "󰄉" :style "min-width: .8rem;" :xalign 1)
                (label :style "min-width: 3.6rem;" :xalign 1
                    :text "${formattime(EWW_TIME - recording-info.start, "%M:%S", "UTC")}")))))

(defwidget status []
    (box :class "button" :style "padding: unset;" :space-evenly false
        (status-audio)
        (status-batteries)
        (status-network)
        (status-settings)
        (status-recording)))
