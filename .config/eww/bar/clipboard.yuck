(deflisten clipboard "wl-paste -w bin/clipboard.sh")

(defwidget clipboard-info []
    (box :space-evenly false :visible {mode.change == "default" || mode.change == "clipboard"}
        (button :class "text-button"
            :onclick "wl-copy -c"
            :onrightclick "xdg-open ${clipboard.data}"
            (box :space-evenly false
                (label :class "text pink" :text '"+')
                (stack :selected {clipboard.mime =~ "text/.*" ? 1 : 0 }
                    :transition "none"
                    :style "margin-left: .5rem"
                    (label :class "text ${clipboard.state == "nil" ? "faint" : ""}" :text "(${clipboard.state == "nil" ? "Empty" : clipboard.mime})" :limit-width 32)
                    (box :space-evenly false
                        (label :limit-width 48
                            :text {clipboard.data})
                        (label :class "text hidden"
                            :visible {clipboard.lines > 0} :style "margin-left: .5rem;"
                            :text "(+${clipboard.lines} Lines)") ))))))
