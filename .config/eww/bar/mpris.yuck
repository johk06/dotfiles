(deflisten mpris "./bin/mpris.py 2>/dev/null")
(deflisten mpd-next "mpc -f '%title%' queued
mpc idleloop player | while read -r line; do mpc -f '%title%' queued; done")

(defwidget mpris-status [pl]
    (label :style "margin-right: .2rem; min-width: 1.5rem;"
        :text "${pl.playing ? "󰎇" : "󰎊"}${pl.shuffle ? "~" : ""}"))

(defwidget mpris-mpd-details [pl] 
    (box :visible {pl.player == "mpd"} :space-evenly false
        (label :limit-width 10
            :text ">${mpd-next}"
            :style "font-size: 0.8em; margin-left: .4rem;")))

(defwidget mpris-title [pl text]
    (box :space-evenly false
        {pl.loop == "track" ? "( " : (pl.loop == "list" ? "[" : "")}
        (label :limit-width 30 :text text)
        (mpris-mpd-details :pl pl)
        {pl.loop == "track" ? " )" : (pl.loop == "list" ? "]" : "")}))

(defwidget mpris-circle [pos]
    (circular-progress :value pos  :class "bar-circle"
        :start-at 75
        :thickness 2
        (label :text {round(pos, 0)})))

(defwidget mpris-bar-player [pl]
    (eventbox
        :onscroll "if [ {} = up ]; then eww update mpris-menu-selected=${min(arraylength(mpris) - 1,mpris-menu-selected+1)}; else eww update mpris-menu-selected=${max(mpris-menu-selected - 1, 0)}; fi"
        (button 
            :class "text-button ${pl.playing ? "mpris-playing" : "mpris-paused"}"
            :onclick "playerctl -p ${pl.id} play-pause; eww update mpris-menu-selected=0"
            :onrightclick "playerctld -p ${pl.id} shift"
            :tooltip "${pl.title} by ${pl.artist?:"Unknown"}
Playing in ${pl.player}"
            (box :space-evenly false
                (mpris-status :pl pl)
                (mpris-title :text {pl.title?: "No Player"} :pl pl)
                (mpris-circle :pos {(pl.playing ? ((EWW_TIME - pl.start_time) / pl.length) : pl.last_progress) * 100})))))

(defwidget mpris-current []
    (revealer :reveal {mpris != []} :transition "slideright"
    (mpris-bar-player :pl {mpris[mpris-menu-selected]})))
