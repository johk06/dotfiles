(deflisten mpris "./bin/mpris.py 2>/dev/null")

(defwidget mpris-status [pl]
    (label :style "margin-right: .6rem; min-width: 1.5rem;"
        :text "${pl.playing ? "≈" : "="}${pl.shuffle ? "?" : ""}"))

(defwidget mpris-title [pl text]
    (box :space-evenly false
        {pl.loop == "track" ? "(" : (pl.loop == "list" ? "[" : "")}
        (label :limit-width 30 :text text)
        {pl.loop == "track" ? ")" : (pl.loop == "list" ? "]" : "")}))

(defwidget mpris-circle [pos]
    (circular-progress :value pos  :class "bar-circle"
        :start-at 75
        :thickness 2
        (label :text {round(pos, 0)})))

(defwidget mpris-bar-player [pl]
    (button :class "text-button ${pl.playing ? "mpris-playing" : "mpris-paused"}"
        :onclick "playerctl play-pause"
        :onrightclick "playerctld shift"
        :tooltip "${pl.title} by ${pl.artist?:"Unknown"}
            Playing in ${pl.player}"
        (box :space-evenly false
            (mpris-status :pl pl)
            (mpris-title :text {pl.title?: "No Player"} :pl pl)
            (mpris-circle :pos {(pl.playing ? ((EWW_TIME - pl.start_time) / pl.length) : pl.last_progress) * 100}))))

(defwidget mpris-current []
    (revealer :reveal {mpris != []} :transition "slideright"
    (mpris-bar-player :pl {mpris[0]})))
