(defvar sway-tablet false)

(defwidget clock []
    (box :space-evenly false
        (button
            :onclick "bin/popup.sh settings-panel settings-panel-open open"
            :timeout "16s"
            :class "button"
            {formattime(EWW_TIME, "%b %d, %H:%M")})
        (button :visible sway-tablet :onclick "wkeys -m close & disown"
            :class "button pink" "Kbd")))
