(defvar status-phone-expanded false)

(defwidget status-phone-media [dev]
    (box :space-evenly false
        :style "margin-left: 0.4em;"
        (button :visible {dev.media != "null"} 
            :class "button ${dev.media.isPlaying ? "mpris-playing" : "mpris-paused"} slim"
            :tooltip "Playing ${dev.media.artist} - ${dev.media.title}
Playing in ${dev.media.player}"
            :onclick "kcd mpris toggle"
            (box :space-evenly false
                (label :style "font-size: 0.9rem;"
                    :text "${dev.media.isPlaying ? "":"" }   ${dev.media.title}"
                    :limit-width 12)
                (mpris-circle :pos {(dev.media.pos / dev.media.length) * 100})))))

(defwidget status-phone-actions [dev] (box
    (button :class "status-text"
        :timeout "16m"
        :onclick `kcd share ${dev.id} "$(zenity --file-selection)"`
        " ")))

(defwidget phone-element [dev]
    (box :space-evenly false
        (button :class "status-text blend ${dev.battery.charging ? "recharging" : ""}"
            :onclick {dev.id == status-phone-expanded 
                ? "${EWW_CMD} update status-phone-expanded=''" 
                : "${EWW_CMD} update status-phone-expanded=${dev.id}"}
            :tooltip "${dev.device.name}: ${dev.battery.charge}% ${dev.battery.charging ? "(charging)" : ""}"
            (label :text
                " ${dev.battery.charging
                    ? (bat-charging[(dev.battery.charge - dev.battery.charge% 10)/10])
                    : (bat-discharging[(dev.battery.charge - dev.battery.charge% 10)/10])}"))
        (revealer :transition "slideright" :reveal {status-phone-expanded == dev.id}
            (box :space-evenly false
                :style "margin-left: 0.4em;"
                (status-phone-actions :dev {dev})
                (status-phone-media :dev {dev})))))

(defwidget status-phone []
    (box :space-evenly false :class "button"
        :style "padding-right: unset; padding-left: unset"
        :visible {arraylength(phone) > 0}
        (for dev in phone 
            (phone-element :dev {dev}))))
