(include "./bar/popups/center.yuck")
(include "./bar/workspace.yuck")
(include "./bar/window.yuck")
(include "./bar/clipboard.yuck")
(include "./bar/marks.yuck")
(include "./bar/status.yuck")
(include "./bar/mode.yuck")
(include "./bar/mpris.yuck")
(include "./bar/notifications.yuck")
(include "./bar/clock.yuck")

(defwindow bar
    :monitor '["DP-1", "eDP-1", 0]'
    :geometry (geometry 
        :x "0px"
        :y "0px"
        :width "100%"
        :height "32px"
        :anchor "top center")
    :stacking "fg"
    :exclusive true
    :namespace "eww-bar"
    :hexpand false
    :vexpand false
    (top-bar))

(defwidget top-bar []
    (centerbox :class "top-bar"
        (box :space-evenly false 
            (box :space-evenly false :class "top-bar-left"
                (mode-symbol)
                (mode-hints)
                (active-window)
                (clipboard-info)))
        (box :space-evenly false :class "top-bar-center"
            (box :space-evenly false
                (mark-list)
                (workspace-list))
            (notifications))
        (box :space-evenly false :halign "end" 
            (box :space-evenly false :class "top-bar-right"
                (mpris-current)
                (systray-expander)
                (status)
                (clock)))))


(defvar systray-expanded false)
(defwidget systray-expander []
    (box :space-evenly false  :class "tray-container"
        (revealer :reveal {systray-expanded} :transition "slideleft"
            (systray :class "tray-box" :spacing 2))
        (button
            :timeout "16s"
            :onclick "${EWW_CMD} update systray-expanded=${!systray-expanded}"
            {systray-expanded ? "" : ""})))
