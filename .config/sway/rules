# vim: ft=swayconfig

# Popups, float by default and maybe set size (if the window is too small or too big otherwise)
for_window [app_id="zenity"]                 floating enable
for_window [app_id="yad"]                    floating enable
for_window [app_id="valent"]                 floating enable
for_window [app_id="xdg-desktop-portal-gtk"] floating enable
for_window [app_id=".*blueman.*"]            floating enable
for_window [app_id="pavucontrol"]            floating enable
for_window [app_id="org.pipewire.Helvum"]    floating enable
for_window [app_id="nm-connection-editor"]   floating enable
for_window [app_id="satty"]                  floating enable
for_window [app_id="nwg-icon-picker"]        floating enable, resize set 300px 400px
for_window [app_id="qalculate-gtk"]          floating enable, resize set 300px 400px

# Make sure I do not type passwords into the wrong dialog
set $popup-critical \
    focus,\
    sticky enable,\
    border pixel 2

for_window [app_id="gcr-prompter"] $popup-critical
for_window [app_id="ssh-askpass"] $popup-critical

# Games {{{
for_window [con_mark="game"] \
    inhibit_idle open,\
    move window to workspace number 10,\
    fullscreen enable,\
    focus

for_window [app_id="gamescope"] mark game

# Minecraft for some reason does not set an app_id, its title is generally like
# "Minecraft* $version", so explicitly match empty app_id and require the
# asterisk, as to avoid false positives
for_window [app_id="^$" title="^Minecraft\*"] mark game
# }}}

# These mostly live in the scratchpad, being able to automatically target them is nice
for_window [app_id="kitty" title="^aerc"]     mark email~
for_window [app_id="kitty" title="^newsboat"] mark news~
for_window [app_id="kitty" title="^iamb"]     mark social~
for_window [app_id="kitty" title="^ncmpcpp"]  mark music~
for_window [app_id="kitty" title="^rmpc"]     mark music~
for_window [app_id="qalculate-gtk"]           mark calc~

# "Pinned" windows, they should automatically be registered for the scratchpad
# That means I can just hit <D-Tab> to put them away quickly
# But only if they're floating, if they're tiled, leave them be
for_window [con_mark="~$"] exec $sc/register-scratch
