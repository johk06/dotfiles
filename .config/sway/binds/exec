# vim: ft=swayconfig

# Basic run program actions

# Terminal
bindsym $mod+Return          exec $term
bindsym $mod+Shift+Return    exec $sc/exec-with --pid $term $floating

# [W]eb
bindsym $mod+W               exec firefox

# [E]xplore, yes this is a shitty windows-like map
bindsym $mod+E               exec kitty zsh -ic lf

# Always quick to lock
bindsym $mod+Semicolon       exec gtklock -d

# Notifications
bindsym $mod+Period          exec swaync-client --close-latest
bindsym $mod+Shift+Period    exec swaync-client --close-all
bindsym $mod+Mod1+Period     exec $sc/invoke-notification

# The default applet
# run programs, plain and simple
bindsym $mod+Space           exec killall rofi || rofi -show drun
# logout, power and other session controls
bindsym $mod+Shift+Semicolon exec killall rofi || rofi -show sys
# search windows
bindsym $mod+Slash           exec killall rofi || rofi -show sway
# qalculate wrapper
bindsym $mod+Shift+Slash     exec killall rofi || rofi -show calc
# custom and firefox bookmarks
bindsym $mod+Shift+Grave     exec killall rofi || rofi -show marks

# Specialized applets
bindsym $mod+O               exec killall rofi || ~/.config/rofi/applets/files/run.sh
bindsym $mod+Minus           exec killall rofi || ~/.config/rofi/applets/pass/run.sh

# Show overview popup
bindsym $mod+Comma           exec $eww/bin/popup.sh ws-overview-win ws-overview-reveal
