# vim: ft=swayconfig

bindsym {
    $mod+Return          exec $term
    $mod+Shift+Return    exec $sc/exec-with --pid kitty $floating
    $mod+W               exec firefox
    $mod+E               exec kitty zsh -ic lf
    $mod+Space           exec killall rofi || rofi -show drun
    $mod+Shift+Semicolon exec killall rofi || rofi -show sys
    $mod+Semicolon       exec gtklock -d
    $mod+Period          exec swaync-client --close-latest
    $mod+Shift+Period    exec swaync-client --close-all
    $mod+Mod1+Period     exec $sc/invoke-notification.sh
    $mod+Slash           exec killall rofi || rofi -show sway
    $mod+O               exec killall rofi || ~/.config/rofi/applets/files/run.sh
    $mod+Minus           exec killall rofi || ~/.config/rofi/applets/pass/run.sh
}
