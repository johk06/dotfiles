# vim: ft=swayconfig

# Bindings for window management
# Not including ./binds/workspaces

bindsym $mod+Q kill

# [D]etach
bindsym $mod+D floating toggle; resize shrink width 800 height 600

bindsym $mod+H focus left
bindsym $mod+J focus down
bindsym $mod+K focus up
bindsym $mod+L focus right

bindsym $mod+Shift+H move left
bindsym $mod+Shift+J move down
bindsym $mod+Shift+K move up
bindsym $mod+Shift+L move right

# Much smarter resize
bindsym $mod+Ctrl+H nop resize left 32
bindsym $mod+Ctrl+J nop resize down 32
bindsym $mod+Ctrl+K nop resize up 32
bindsym $mod+Ctrl+L nop resize right 32

# Exchange windows
bindsym $mod+Mod1+H exec $sc/swap.sh left
bindsym $mod+Mod1+J exec $sc/swap.sh down
bindsym $mod+Mod1+K exec $sc/swap.sh up
bindsym $mod+Mod1+L exec $sc/swap.sh right

# Rarely needed, TODO: make sure I really need this
bindsym $mod+S splitv
bindsym $mod+V splith

# "real" fullscreen
bindsym $mod+F fullscreen
# only hide gaps around window, see ./config for different gaps
bindsym $mod+Shift+F exec $sc/set-gaps.sh 0

# Like vim for numbers
bindsym $mod+A resize grow width 64px; resize grow height 64px
bindsym $mod+X resize shrink width 64px; resize shrink height 64px 

# Like the vim z* family of commands
bindsym $mod+Z focus mode_toggle

# Suspend a window's underlying process
bindsym $mod+Mod1+Z exec $sc/stop-or-continue.sh
# Send an arbitrary signal
bindsym $mod+Ctrl+Z exec $sc/signal-window.sh

# Like VIM
bindsym $mod+Apostrophe exec $sc/on-mark.sh initial focus
bindsym $mod+Shift+Apostrophe exec $sc/on-mark.sh search focus

# (G)et
bindsym $mod+G exec $sc/on-mark.sh initial move workspace current
bindsym $mod+Shift+G exec $sc/on-mark.sh search move workspace current

# (T)ag, (M)ark is used for media
bindsym $mod+T exec swaymsg mark $(wayinput -l -1 -t "Mark")
bindsym $mod+U exec $sc/unmark.sh

# Select-Based resize
bindsym --whole-window $mod+Shift+BTN_RIGHT exec $sc/select-float-region.sh
