# vim: ft=swayconfig

# Bindings for window management
# That means operations that affect an individual window and not much else

# [Q]uit
bindsym $mod+Q kill

# [D]etach
bindsym $mod+D floating toggle; resize shrink width 800 height 600

# Like the vim z* family of commands, alternatively, change the Z-Coordinate
bindsym $mod+Z focus mode_toggle

# Moving & Resizing {{{
bindsym $mod+H focus left
bindsym $mod+J focus down
bindsym $mod+K focus up
bindsym $mod+L focus right

bindsym $mod+Shift+H move left
bindsym $mod+Shift+J move down
bindsym $mod+Shift+K move up
bindsym $mod+Shift+L move right

# Much smarter resize
bindsym $mod+Ctrl+H nop resize left 32
bindsym $mod+Ctrl+J nop resize down 32
bindsym $mod+Ctrl+K nop resize up 32
bindsym $mod+Ctrl+L nop resize right 32

# Exchange windows
bindsym $mod+Mod1+H exec $sc/swap left
bindsym $mod+Mod1+J exec $sc/swap down
bindsym $mod+Mod1+K exec $sc/swap up
bindsym $mod+Mod1+L exec $sc/swap right

# Like vim for numbers
bindsym $mod+A resize grow width 64px; resize grow height 64px
bindsym $mod+X resize shrink width 64px; resize shrink height 64px 

# NOTE: Focus needs to be on the container group that needs to be equaled
# e.g. In a situation like this:
# [Win1]  [ Win3 ]
# [Win2]  [      ]
# D-= will only resize the general splits to be equal when focus is on the right window
# or the container containing both on the left
bindsym $mod+Equal resize set width 50ppt; resize set height 50ppt
# }}}
# Container Operations {{{
# Force split, rarely needed, mainly for tabs and floating windows
bindsym $mod+S splitv
bindsym $mod+V splith
# [B]oxed
bindsym $mod+B layout toggle split tabbed
bindsym $mod+Shift+B layout toggle stacking split

# "real" fullscreen
bindsym $mod+F fullscreen
# only hide gaps around window, see ./config for different gaps
bindsym $mod+Shift+F exec $sc/set-gaps 0

# These seem annoying to type, but with Backspace and Delete as taps
# on the shift keys they're quite natural as forward/back-like actions
bindsym $mod+Backspace focus parent
bindsym $mod+Delete focus child
# }}}

# Suspend a window's underlying process
bindsym $mod+Mod1+Z exec $sc/stop-or-continue
# Send an arbitrary signal
bindsym $mod+Ctrl+Z exec $sc/signal-window

# Tags {{{
# Like Vim
bindsym $mod+Apostrophe exec $sc/on-mark initial focus
bindsym $mod+Shift+Apostrophe exec $sc/on-mark search focus

# (G)et or (G)rab
bindsym $mod+G exec $sc/on-mark initial move workspace current
bindsym $mod+Shift+G exec $sc/on-mark search move workspace current

# (T)ag, (M)ark is used for media
bindsym $mod+T exec $sc/mark
bindsym $mod+U exec $sc/unmark

# Tag a window for the scratchpad, by the first word in the title
bindsym $mod+Mod1+T exec $sc/mark-by-title "~" '^([a-zA-Z]*)'
# By the final file name component
bindsym $mod+Ctrl+T exec $sc/mark-by-title "" '([^\s/]*)$'
# By the initial file-like component
bindsym $mod+Shift+T exec $sc/mark-by-title "" '^([^\s/]*)'
# By the initial non-description component
bindsym $mod+Ctrl+Shift+T exec $sc/mark-by-title "" '^([^-]*)'
# }}}

# Move to a specific position {{{
bindsym $mod+Mod1+KP_7 exec $sc/move-quadrant start start
bindsym $mod+Mod1+KP_8 exec $sc/move-quadrant center start
bindsym $mod+Mod1+KP_9 exec $sc/move-quadrant end start
bindsym $mod+Mod1+KP_4 exec $sc/move-quadrant start center
bindsym $mod+Mod1+KP_5 exec $sc/move-quadrant center center
bindsym $mod+Mod1+KP_6 exec $sc/move-quadrant end center
bindsym $mod+Mod1+KP_1 exec $sc/move-quadrant start end
bindsym $mod+Mod1+KP_2 exec $sc/move-quadrant center end
bindsym $mod+Mod1+KP_3 exec $sc/move-quadrant end end

bindsym $mod+Mod1+7 exec $sc/move-quadrant start start
bindsym $mod+Mod1+8 exec $sc/move-quadrant center start
bindsym $mod+Mod1+9 exec $sc/move-quadrant end start
bindsym $mod+Mod1+4 exec $sc/move-quadrant start center
bindsym $mod+Mod1+5 exec $sc/move-quadrant center center
bindsym $mod+Mod1+6 exec $sc/move-quadrant end center
bindsym $mod+Mod1+1 exec $sc/move-quadrant start end
bindsym $mod+Mod1+2 exec $sc/move-quadrant center end
bindsym $mod+Mod1+3 exec $sc/move-quadrant end end
# }}}

# Select-Based resize, not sure whether I want this
bindsym --whole-window $mod+Shift+BTN_RIGHT exec $sc/select-float-region

# A dedicated mode for better adjustements
mode "layout" {
    bindsym Escape mode "default"
    bindsym H focus left
    bindsym J focus down
    bindsym K focus up
    bindsym L focus right

    bindsym Shift+H move left
    bindsym Shift+J move down
    bindsym Shift+K move up
    bindsym Shift+L move right

    # Much smarter resize
    bindsym Ctrl+H nop resize left 32
    bindsym Ctrl+J nop resize down 32
    bindsym Ctrl+K nop resize up 32
    bindsym Ctrl+L nop resize right 32

    # Exchange windows
    bindsym Mod1+H exec $sc/swap left
    bindsym Mod1+J exec $sc/swap down
    bindsym Mod1+K exec $sc/swap up
    bindsym Mod1+L exec $sc/swap right

    bindsym Z move position center

    bindsym KP_7 exec $sc/move-quadrant start start
    bindsym KP_8 exec $sc/move-quadrant center start
    bindsym KP_9 exec $sc/move-quadrant end start
    bindsym KP_4 exec $sc/move-quadrant start center
    bindsym KP_5 exec $sc/move-quadrant center center
    bindsym KP_6 exec $sc/move-quadrant end center
    bindsym KP_1 exec $sc/move-quadrant start end
    bindsym KP_2 exec $sc/move-quadrant center end
    bindsym KP_3 exec $sc/move-quadrant end end

    bindsym 7 exec $sc/move-quadrant start start
    bindsym 8 exec $sc/move-quadrant center start
    bindsym 9 exec $sc/move-quadrant end start
    bindsym 4 exec $sc/move-quadrant start center
    bindsym 5 exec $sc/move-quadrant center center
    bindsym 6 exec $sc/move-quadrant end center
    bindsym 1 exec $sc/move-quadrant start end
    bindsym 2 exec $sc/move-quadrant center end
    bindsym 3 exec $sc/move-quadrant end end

    bindsym D floating toggle
    bindsym A resize grow width 64px; resize grow height 64px
    bindsym X resize shrink width 64px; resize shrink height 64px 

    bindsym S splitv
    bindsym V splith
    bindsym B layout toggle split tabbed
    bindsym Shift+B layout toggle stacking split

    bindsym F fullscreen
    bindsym Shift+F exec $sc/set-gaps 0

    bindsym O focus parent
    bindsym I focus child
}

bindsym $mod+Escape mode "layout"
