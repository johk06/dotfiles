# vim: ft=swayconfig

set $audio $sc/audio-popup.sh

# output
bindsym --locked XF86AudioRaiseVolume        exec $audio DEFAULT_SINK raise 3
bindsym --locked XF86AudioLowerVolume        exec $audio DEFAULT_SINK lower 3
bindsym --locked Ctrl+XF86AudioRaiseVolume   exec $audio DEFAULT_SINK raise 10
bindsym --locked Ctrl+XF86AudioLowerVolume   exec $audio DEFAULT_SINK lower 10
bindsym --locked XF86AudioMute               exec $audio DEFAULT_SINK mute

# input
bindsym --locked Mod1+XF86AudioRaiseVolume      exec $audio DEFAULT_SOURCE raise 3
bindsym --locked Mod1+XF86AudioLowerVolume      exec $audio DEFAULT_SOURCE lower 3
bindsym --locked Mod1+Ctrl+XF86AudioRaiseVolume exec $audio DEFAULT_SOURCE raise 10
bindsym --locked Mod1+Ctrl+XF86AudioLowerVolume exec $audio DEFAULT_SOURCE lower 10
bindsym --locked Mod1+XF86AudioMute             exec $audio DEFAULT_SOURCE mute

# screen brightness
bindsym --locked XF86MonBrightnessUp         exec $sc/brightness.sh set +5
bindsym --locked XF86MonBrightnessDown       exec $sc/brightness.sh set -5
bindsym --locked Shift+XF86MonBrightnessUp   exec $sc/brightness.sh set +20
bindsym --locked Shift+XF86MonBrightnessDown exec $sc/brightness.sh set -20
bindsym --locked Mod4+XF86MonBrightnessUp    exec $sc/brightness.sh set +50
bindsym --locked Mod4+XF86MonBrightnessDown  exec $sc/brightness.sh set -50

# media players
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked Shift+XF86AudioNext exec playerctl next
bindsym --locked Shift+XF86AudioPrev exec playerctl prev
bindsym --locked Shift+XF86AudioPlay exec playerctld shift
bindsym --locked XF86AudioNext exec playerctl position 5+
bindsym --locked XF86AudioPrev exec playerctl position 5-

bindsym $mod+XF86AudioMute exec ~/.config/rofi/applets/mute/run.sh
bindsym $mod+Shift+M exec ~/.config/rofi/applets/mute/run.sh

mode "media" {
    bindsym {
    Escape mode "default" 
    Space exec playerctl play-pause

    K exec $audio DEFAULT_SINK raise 3
    J exec $audio DEFAULT_SINK lower 3
    Shift+K exec $audio DEFAULT_SINK raise 10
    Shift+J exec $audio DEFAULT_SINK lower 10
    N       exec $sc/pulse-cycle.sh sink next
    Shift+N exec $sc/pulse-cycle.sh sink prev
    M       exec $audio DEFAULT_SINK mute

    Mod1+K exec $audio DEFAULT_SOURCE raise 3
    Mod1+J exec $audio DEFAULT_SOURCE lower 3
    Mod1+Shift+K exec $audio DEFAULT_SOURCE raise 10
    Mod1+Shift+J exec $audio DEFAULT_SOURCE lower 10
    Mod1+N       exec $sc/pulse-cycle.sh source next
    Mod1+Shift+N exec $sc/pulse-cycle.sh source prev
    Mod1+M       exec $audio DEFAULT_SOURCE mute


    S exec playerctl position 0
    H exec playerctl position 5-
    L exec playerctl position 5+
    Shift+H exec playerctl previous
    Shift+L exec playerctl next

    Q exec ~/.config/rofi/applets/mpd/run.sh; mode "default"
    P exec $sc/mpd-play.sh; mode "default"

    Shift+M exec ~/.config/rofi/applets/mute/run.sh; mode "default"

    # Mappings for number keys {{{
    1 exec $audio DEFAULT_SINK set 0.1
    2 exec $audio DEFAULT_SINK set 0.2
    3 exec $audio DEFAULT_SINK set 0.3
    4 exec $audio DEFAULT_SINK set 0.4
    5 exec $audio DEFAULT_SINK set 0.5
    6 exec $audio DEFAULT_SINK set 0.6
    7 exec $audio DEFAULT_SINK set 0.7
    8 exec $audio DEFAULT_SINK set 0.8
    9 exec $audio DEFAULT_SINK set 0.9
    0 exec $audio DEFAULT_SINK set 0

    KP_1 exec $audio DEFAULT_SINK set 0.1
    KP_2 exec $audio DEFAULT_SINK set 0.2
    KP_3 exec $audio DEFAULT_SINK set 0.3
    KP_4 exec $audio DEFAULT_SINK set 0.4
    KP_5 exec $audio DEFAULT_SINK set 0.5
    KP_6 exec $audio DEFAULT_SINK set 0.6
    KP_7 exec $audio DEFAULT_SINK set 0.7
    KP_8 exec $audio DEFAULT_SINK set 0.8
    KP_9 exec $audio DEFAULT_SINK set 0.9
    KP_0 exec $audio DEFAULT_SINK set 0

    # Input
    Mod1+1 exec $audio DEFAULT_SOURCE set 0.1
    Mod1+2 exec $audio DEFAULT_SOURCE set 0.2
    Mod1+3 exec $audio DEFAULT_SOURCE set 0.3
    Mod1+4 exec $audio DEFAULT_SOURCE set 0.4
    Mod1+5 exec $audio DEFAULT_SOURCE set 0.5
    Mod1+6 exec $audio DEFAULT_SOURCE set 0.6
    Mod1+7 exec $audio DEFAULT_SOURCE set 0.7
    Mod1+8 exec $audio DEFAULT_SOURCE set 0.8
    Mod1+9 exec $audio DEFAULT_SOURCE set 0.9
    Mod1+0 exec $audio DEFAULT_SOURCE set 0

    Mod1+KP_1 exec $audio DEFAULT_SOURCE set 0.1
    Mod1+KP_2 exec $audio DEFAULT_SOURCE set 0.2
    Mod1+KP_3 exec $audio DEFAULT_SOURCE set 0.3
    Mod1+KP_4 exec $audio DEFAULT_SOURCE set 0.4
    Mod1+KP_5 exec $audio DEFAULT_SOURCE set 0.5
    Mod1+KP_6 exec $audio DEFAULT_SOURCE set 0.6
    Mod1+KP_7 exec $audio DEFAULT_SOURCE set 0.7
    Mod1+KP_8 exec $audio DEFAULT_SOURCE set 0.8
    Mod1+KP_9 exec $audio DEFAULT_SOURCE set 0.9
    Mod1+KP_0 exec $audio DEFAULT_SOURCE set 0
    # }}}
    }
}

bindsym $mod+M mode "media"
