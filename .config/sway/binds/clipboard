# vim: ft=swayconfig

# manage various aspects related to the clipboard
# generally anything under <M-* is related to the primary selectio

mode "clipboard" {
    bindsym Escape mode "default"

    # Print, stay in the mode so that another operation can be specified
    bindsym P exec $sc/print-clipboard
    bindsym Mod1+P exec $sc/print-clipboard -p

    # Copy the other clipboard
    bindsym Y exec wl-paste -n -p | wl-copy; mode "default"
    bindsym Mod1+Y exec wl-paste -n | wl-copy -p; mode "default"

    bindsym A exec (wl-paste -n && wl-paste -n -p) | wl-copy; mode "default"
    bindsym Mod1+A exec (wl-paste -n -p && wl-paste -n) | wl-copy -p; mode "default"
    bindsym I exec (wl-paste -n -p && wl-paste -n) | wl-copy; mode "default"
    bindsym Mod1+I exec (wl-paste -n && wl-paste -n -p) | wl-copy -p; mode "default"

    # Exchange them
    bindsym X exec $sc/exchange-clipboard; mode "default"
    # And print the one specified
    bindsym Mod1+X exec $sc/exchange-clipboard; mode "default"; exec $sc/print-clipboard -p
    bindsym Shift+X exec $sc/exchange-clipboard; mode "default"; exec $sc/print-clipboard

    # Edit the clipboard
    bindsym E exec $sc/edit-clipboard; mode "default"
    bindsym Mod1+E exec $sc/edit-clipboard -p; mode "default"

    # Clear
    bindsym C exec wl-copy -c; mode "default"
    bindsym Mod1+C exec wl-copy -p -c; mode "default"

    # Make up for the lack of pipes in graphical environments
    bindsym T exec $sc/translate; mode "default"
    bindsym Mod1+T exec $sc/translate -p; mode "default"
}

bindsym $mod+Y mode "clipboard"
