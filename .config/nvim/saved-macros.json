{
    "macros": {
        "extract-func": {
            "desc": "Extract statements from function",
            "keys": "yifgsaf"
        },
        "lua-format-strlit": {
            "desc": "Append :format() to a string literal",
            "keys": "ysa\")f)a:format()<Left>"
        },
        "lua-make-pcall": {
            "desc": "Wrap function call in pcall()",
            "keys": "vauo<Esc>ipcall(<Esc>f(cl,<Space><Esc>"
        },
        "lua-un-pcall": {
            "desc": "Remove pcall() from function call",
            "keys": "viuo<Esc>?pcall<CR>df(f,r(lx"
        },
        "space-line": {
            "keys": "]<Space>2j",
            "desc": "Add space below line and move to next line"
        }
    }
}

