#!/bin/sh

if [ "$1" = "-i" ]; then
    exec searchyt "$2" | xargs -I__ mpd-yt __ "${3:--}"
    exit
fi

if [ -z "$2" ] || [ "$2" = "-" ]; then
    TMP="$XDG_CACHE_HOME/yt-mpd"
    [ ! -d "$TMP" ] && mkdir -p "$TMP"

    OUTDIR="$TMP/$(date +%s)"
else
    OUTDIR="$2"
fi

mkdir -p "$OUTDIR"
cd "$OUTDIR" || exit 1

URL="$1"; shift 2
yt-dlp -x "$URL" "$@" --no-simulate --embed-metadata --embed-thumbnail --print after_move:filepath |
    while read -r filename; do
        # adding files by path requires local socket connection
        mpc --host="$XDG_RUNTIME_DIR/mpd/socket" add "$filename"
    done
