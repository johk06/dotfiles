#!/usr/bin/env bash

# Code referenced: https://github.com/xPaw/PHP-Minecraft-Query/blob/master/src/MinecraftPing.php
# As well as the wiki: https://minecraft.wiki/w/Java_Edition_protocol/Server_List_Ping
# The status itself is well-formed json, just pipe to jq

# Uses xxd to assemble the binary parts of the message, plain text is interleaved

SRV="$1"
PORT="${2:-25565}"

read-varint() {
    num=0
    idx=0

    # Ensure single bit ASCII, No splitting, read a single char(=byte)
    while LC_ALL=C IFS= read -r -d '' -n 1 byt; do
        # NOTE: bash uses NULL-terminated C-style strings, for e.g. zsh this
        # would actually be a string with just a single \0 in it, but that would also work
        if [[ "${#byt}" == 0 ]]; then
            bytval=0
        else
            printf -v bytval %d "'${byt}"
        fi

        # the positional value is the value without the high bit
        ((num |= ((bytval & 127) << (idx * 7))))
        ((idx++))

        # if the high bit isn't set, this is the end of the number
        if (((bytval & 128) != 128)); then
            break
        fi
    done

    REPLY="$num"
}

{
    # Message Length, Protocol Version, Address Length
    printf "00: %02x 00ff ffff 0f %02x" \
        $((5 + 1 + ${#SRV} + 3)) "${#SRV}" |
        xxd -r

    printf '%s' "$SRV" # Address, assumed to be UTF-8

    # Port, Status, Handshake, finally: Request Information
    printf '00: %04x 01 0100' "$PORT" | xxd -r
} | nc -N "$SRV" "$PORT" | {
    read-varint
    read-varint

    # Length of reply
    read-varint
    head -c "$REPLY"
}
