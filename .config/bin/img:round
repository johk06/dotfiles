#!/usr/bin/env bash
# Credit to: https://stackoverflow.com/a/18992215 for the magick code

die() {
    echo "$@" >&2
    exit 1
}

usage() {
    echo "Usage: img:round [-r RADIUS] [-R RADIUS%] INPUT OUTPUT" >&2
    exit 1

}

RADIUS=12
PERCENTAGE=0
while getopts ":r:R:h" o; do
    case "$o" in
    r)
        RADIUS="$OPTARG"
        ((RADIUS == 0)) && die "Radius must be a number > 0"
        ;;
    R)
        RADIUS="$OPTARG"
        ((RADIUS > 100)) && die "Percentage must be <= 100"
        PERCENTAGE=1
        ;;
    *) usage ;;
    esac
done
shift $((OPTIND - 1))
INPUT="${1:--}"
# NOTE: we need to specify png:- so magick knows that transparency is supported
OUTPUT="${2:-png:-}"

if ((PERCENTAGE)); then
    [ "$INPUT" = "-" ] && die "Input for percentage cannot be from standard input"

    read -r width height < <(magick "$INPUT" -ping -format "%w %h" info:)
    MIN=$width
    [ "$height" -lt "$width" ] && MIN=$height

    RADIUS=$((MIN * $RADIUS / 100))
fi

MASK="fill black polygon 0,0 0,$RADIUS $RADIUS,0 fill white circle $RADIUS,$RADIUS $RADIUS,0"

magick "$INPUT" \
    \( +clone -alpha extract \
    -draw "$MASK" \
    \( +clone -flip \) -compose Multiply -composite \
    \( +clone -flop \) -compose Multiply -composite \
    \) -alpha off -compose CopyOpacity -composite "$OUTPUT"
