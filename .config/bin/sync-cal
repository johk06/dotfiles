#!/usr/bin/env bash

mkdir -p ~/cal/{,.}{contacts,private}

pimsync sync

for dir in ~/cal/.contacts/*; do
    read dispname < "$dir/displayname"
    ln -s "$dir" ~/cal/contacts/"${dispname// /_}"
done

for dir in ~/cal/.private/*; do
    read dispname < "$dir/displayname"
    ln -s "$dir" ~/cal/private/"${dispname// /_}"
done
