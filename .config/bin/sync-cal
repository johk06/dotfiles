#!/usr/bin/env bash

mkdir -p ~/cal/{,.}{contacts,private}
mkdir -p ~/cal/uni/{1,2}

pimsync sync "$@"

for dir in ~/cal/.contacts/*; do
    read dispname < "$dir/displayname"
    ln -sT "$dir" ~/cal/contacts/"${dispname// /_}"
done

for dir in ~/cal/.private/*; do
    read dispname < "$dir/displayname"
    ln -sT "$dir" ~/cal/private/"${dispname// /_}"
done
