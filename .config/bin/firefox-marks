#!/bin/sh

# List marks from within firefox' database

TMPDB="$XDG_CACHE_HOME/firefox-marks"
[ ! -d "$TMPDB/img" ] && mkdir -p "$TMPDB"
DBFILE="$TMPDB/db"

# Copy to avoid locking
cp ~/.mozilla/firefox/*.default-release/places.sqlite "$DBFILE"

sqlite3 "$DBFILE" -separator $'\t' <<'SQL'
SELECT b.title, p.url
FROM moz_bookmarks b
JOIN moz_places p ON b.fk = p.id
WHERE b.type = 1
SQL
