#!/usr/bin/env bash

CACHEDIR="$XDG_CACHE_HOME/mpd-radio"

if [[ ! -d "$CACHEDIR" ]]; then
    mkdir -p "$CACHEDIR"
fi

usage() {
    echo "Usage: mpd-radio NAME [-l LANGUAGE] [-c COUNTRY] [-d DESCRIPTION]" >&2
    exit 1
}

while getopts ":l:c:d:p" o; do
    case "$o" in
    "l")
        EXTRA_QUERY="$EXTRA_QUERY&language=$OPTARG"
        ;;
    "c")
        EXTRA_QUERY="$EXTRA_QUERY&countrycode=$OPTARG"
        ;;
    "d")
        EXTRA_QUERY="$EXTRA_QUERY&description=$OPTARG"
        ;;
    "p")
        print_to_stdout=y
        ;;
    *) usage ;;
    esac
done

shift $((OPTIND - 1))
if [[ $# -lt 1 ]]; then
    usage
fi
NAME="$1"
QUERY="name=$1$EXTRA_QUERY"
shift

url="api.radio-browser.info"
read -r url < <(dig +short all.api.radio-browser.info | shuf -n 1)

if [ -n "$print_to_stdout" ]; then
    FILE=/dev/stdout
else
    FILE="$CACHEDIR/$NAME.m3u"
fi

curl --silent --header "User-Agent: script/1.0" \
    "http://${url:-1}/json/stations/search?$QUERY" |
    jq -r 'max_by(.bitrate)|"#EXTM3U", "#EXTINF:0,Radio: \(.name)", .url' \
        >"$FILE"

[ -z "$print_to_stdout" ] && mpc --host="$XDG_RUNTIME_DIR/mpd/socket" load "$FILE"
