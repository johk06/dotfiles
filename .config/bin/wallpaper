#!/bin/bash

DIR="$HOME/.config/background"
WALL="$DIR/wall"
THUMB="$DIR/thumb"
LOCK="$DIR/lock"

THUMB_RESOLUTION=384x384 # Provides a clean 10x downscale from 3840x2160

function set_walls() {
    if ! awww query; then
        awww-daemon &
        sleep 1
    fi
    awww img -t outer \
        --transition-pos bottom \
        --transition-duration 1 \
        --transition-fps 60 \
        "${WALL}"
}
function set_as_wall() {
    unlink "${WALL}"
    ln -s "$1" "${WALL}"

    magick "${WALL}" -resize $THUMB_RESOLUTION "$THUMB" &
}

function set_as_lock() {
    unlink "${LOCK}"
    ln -s "$1" "${LOCK}"
}
case $1 in
lock)
    set_as_lock "$2"
    ;;
wall)
    set_as_wall "$2"
    set_walls
    ;;
both)
    set_as_wall "$2"
    set_as_lock "$2"
    set_walls
    ;;
set)
    set_walls
    ;;
*) exit 1;;
esac

for hook in "$DIR"/hooks/*; do
    "$hook" "$1"
done
