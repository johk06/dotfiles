#!/bin/sh

usage() {
    echo "Usage: pargrep [-i] pattern files" >&2
    echo "Print all paragraphs containing pattern" >&2
    exit 1
}

IGNORECASE=0
while getopts "i" o; do
    case "$o" in
    i) IGNORECASE=1 ;;
    *) usage ;;
    esac
done
shift $((OPTIND - 1))
if [ $# -eq 0 ]; then
    usage
fi

PATTERN="$1"
shift
awk -v IGNORECASE="$IGNORECASE" -v RS="" -v pat="$PATTERN" '$0 ~ pat' "$@"
