#!/usr/bin/env bash

# Plot lines from stdin with a bunch of sane presets

usage() {
    echo "Usage: plot-lines [-tcekslr]"
    exit 1
}

KIND="linespoints"
COLOR="red"
ROTATE=0
STEP=1
LABEL="2|%s"
while getopts ":t:c:e:k:r:s:l:" o; do
    case "$o" in
    t) TITLE="$OPTARG" ;;
    c) COLOR="$OPTARG" ;;
    e) EXPR="$OPTARG" ;;
    k) KIND="$OPTARG" ;;
    r) ROTATE="$OPTARG";;
    s) STEP="$OPTARG";;
    l) LABEL="$OPTARG";;
    *) usage ;;
    esac
done

IFS="|" read -r FIELDS REST <<< "$LABEL"
for field in $FIELDS; do
    FIELDLIST+=",strcol($field)"
done
TICKEXPR="sprintf('$REST'$FIELDLIST)"

shift $((OPTIND - 1))

EXP="
$EXPR
set xtic rotate by $ROTATE;
plot '-' using 0:1:xticlabels(int(\$0)%$STEP == 0 ? $TICKEXPR : '') with $KIND
title '$TITLE'
lc rgb '$COLOR'
"

gnuplot -p -e "$EXP"
