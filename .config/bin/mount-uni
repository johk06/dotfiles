#!/bin/sh

# Mount uni nextcloud using webdav

MOUNTPOINT="${1:-$HOME/uni/cloud}"
mkdir -p "$MOUNTPOINT"

pass-get "uni/1" cloud user cloudurl | {
    read -r PASS
    read -r USER
    read -r URL

    export RCLONE_CONFIG_UNI_TYPE=webdav
    export RCLONE_CONFIG_UNI_URL="$URL/remote.php/dav/files/$USER"
    export RCLONE_CONFIG_UNI_VENDOR=nextcloud
    export RCLONE_CONFIG_UNI_USER="$USER"
    export RCLONE_CONFIG_UNI_PASS="$(echo  "$PASS" | rclone obscure -)"

    rclone mount UNI: "$MOUNTPOINT" \
        --vfs-cache-mode writes
    umount "$MOUNTPOINT"
}
