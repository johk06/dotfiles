#!/usr/bin/env bash

#
# Convert the path inside a xournalpp file into a relative one to avoid
# dependencies on the exact filesystem layout
#

INPUT="$1"
OUTPUT="${2:-$INPUT}"

PDFNAME="${INPUT%.xopp}.pdf"
PDFNAME="${PDFNAME##*/}"

TMPFILE="$(mktemp)"

gzip -d <"$INPUT" |
    sed '/^<background type="pdf" domain="absolute"/ s/filename="[^"]*"/filename="'"$PDFNAME"'"/' |
    gzip - - >"$TMPFILE"

mv "$TMPFILE" "$OUTPUT"
