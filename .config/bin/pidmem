#!/bin/sh

get_proc_mem() {
    if [ -r "/proc/$1/cmdline" ]; then
        awk '$1 == "VmRSS:" {print $2}' </proc/"$1"/status
    else
        echo
    fi
}

print_on_stdin() {
    while read -r pid; do
        get_proc_mem "$pid"
    done
}

if [ $# -eq 0 ]; then
    print_on_stdin
else
    for pid in "$@"; do
        if [ "$pid" = "-" ]; then
            print_on_stdin
        else
            get_proc_mem "$pid"
        fi
    done
fi
