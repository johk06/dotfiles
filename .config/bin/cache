#!/bin/sh

CACHEDIR="$XDG_CACHE_HOME/command"

# Run a process and cache result in a file
# If already cached, return the file's content
# Useful to experiment with e.g. web requests
# If the file is given as `-`, then a new temporary file is created
# and used, based on the command name

# Example: cache - curl wttr.in

if [ $# -lt 2 ]; then
    echo "Usage: cache FILE COMMAND" >&2
    echo "Run COMMAND and cache output in FILE" >&2
    exit 1
fi

FILE="$1"
shift

# the usual convention of stdout doesn't make sense anyways
# use `-` to generate a file based on the command
if [ "$FILE" = "-" ]; then
    [ ! -d "$CACHEDIR" ] && mkdir -p "$CACHEDIR"
    FILE="$CACHEDIR/$(echo "$@" | sed 's/\//%/g')"
fi

if [ -f "$FILE" ]; then
    cat "$FILE"
else
    "$@" | tee "$FILE"
fi
