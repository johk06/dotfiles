#!/usr/bin/env luajit


---@enum Token
local Pho = {
    vowel = "v",
    consonant = "c",
    liquid = "l",
    lingual = "L",
    nasal = "n",
    sibilant = "s",
}

local map = function(t, f)
    local ret = {}
    for i, v in ipairs(t) do
        ret[i] = f(v)
    end

    return ret
end

-- Classes of sounds {{{
local vowels = {
    a = true,
    e = true,
    i = true,
    o = true,
    u = true,
    y = true,
}

local linguals = {
    l = true,
}
local liquids = {
    w = true,
    r = true,
}

local nasals = {
    n = true,
    m = true
}

local sibilants = {
    s = true,
    z = true
}

local h_digraphs = {
    t = true,
    r = true,
    p = true,
    w = true,
    s = true,
    c = true,
    z = true
}
-- }}}

local prev = function(word, i)
    if i <= #word and i > 1 then
        return word:sub(i - 1, i - 1)
    else
        return ""
    end
end

---@param _word string
local normalize_phonetic = function(_word)
    local word = _word:lower()
    -- these are hard to impossible to handle otherwise
    return word:gsub("tio", "she"):gsub("sch", "sh"):gsub("gh", "g")
end

---@param _word string
---@return Token[]
local tokenize_word = function(_word)
    local word = normalize_phonetic(_word)
    local tokens = {}
    for i = 1, #word do
        local c = word:sub(i, i)
        local p = prev(word, i)
        if c == "h" and h_digraphs[p] then
            if p == "c" then
                table.insert(tokens, "c")
            end
            -- skip
        elseif c == "g" and p == "n" then
            -- skip
        elseif c == "x" then
            table.insert(tokens, "c")
            table.insert(tokens, "c")
        elseif vowels[c] then
            if p == "y" then
                tokens[#tokens] = "c"
            end
            if tokens[#tokens] ~= "v" then
                table.insert(tokens, "v")
            end
        elseif liquids[c] then
            table.insert(tokens, "l")
        elseif linguals[c] then
            if tokens[#tokens] == "L" and tokens[#tokens - 1] == "v" then
            else
                table.insert(tokens, "L")
            end
        elseif sibilants[c] then
            table.insert(tokens, "s")
        elseif nasals[c] then
            table.insert(tokens, "n")
        else
            table.insert(tokens, "c")
        end
    end

    return tokens
end

local find_next = function(tokens, i, t)
    for j = i, #tokens do
        if tokens[j] == t then
            return j
        end
    end
    return nil
end

---@param tokens Token[]
---@return Token[][]
local to_syllables = function(tokens)
    local ret = {}
    local cur = {}
    local last = {}

    local i = 1
    while i <= #tokens do
        local t = tokens[i]
        table.insert(cur, t)
        if t == "v" then
            local nextv = find_next(tokens, i + 1, "v")
            if nextv then
                local before_nextv = nextv - 1
                if before_nextv ~= i + 1 then
                    local next = tokens[i + 1]
                    local next2 = tokens[i + 2]
                    if next == "n" or next == "l" or next == "L" then
                        table.insert(cur, next)
                        i = i + 1
                        if (next2 == "c" or next2 == "n") and i + 2 ~= nextv then
                            table.insert(cur, next2)
                            i = i + 1
                        end
                    elseif (next == "c" or next == "s")
                        and (next2 == "c"
                            or next2 == "s")
                    then
                        table.insert(cur, next)
                        i = i + 1
                        local next3 = tokens[i + 3]
                        if next3 == "c" and i + 2 ~= nextv then
                            table.insert(cur, next2)
                            i = i + 1
                        end
                    end
                end
            end
            if #last > 0 then
                table.insert(ret, last)
            end
            last = cur
            cur = {}
        end

        i = i + 1
    end
    if #cur ~= 0 then
        for _, e in ipairs(cur) do
            table.insert(last, e)
        end
    end
    if #last ~= 0 then
        table.insert(ret, last)
    end

    return ret
end

local sub_matches = function(rules, arg)
    for _, k in ipairs(rules) do
        if k == arg then
            return true
        end
    end
    return false
end

local function rule_matches(rules, args)
    for i, spec in ipairs(rules) do
        local arg = args[i]
        if arg == nil and spec == nil then
        else
            if type(spec) == "table" then
                if not sub_matches(spec, arg) then
                    return false
                end
            elseif spec == false then
            elseif spec ~= arg then
                return false
            end
        end
    end
    return true
end
local rule = function(tbl)
    return function(...)
        local args = { ... }

        return rule_matches(tbl, args)
    end
end

local coda_rules, onset_rules
do
    local s, r, l, L, c, v, n = "s", "r", "l", "L", "c", "V", "n"
    local _n = { "l", "L", "n" }
    local _s = { "l", "L", "s" }
    local _l = { "r", "l", "L" }
    local _L = { "r", "l", "L", "s" }
    local _c = { "c", "s" }
    local cls = { "c", "L", "s" }
    coda_rules = {
        ["Liquid between sibilant and plosive"] = rule { s, _l, c },
        ["too many l's after C (2)"] = rule { c, _l, _l },
        ["liquid-liquid consonant"] = rule { _l, _l, c },
        ["final double nasal"] = rule { false, n, n },
        ["final double lingual"] = rule { false, L, L },
        ["final CLC"] = rule { _c, _L, _c },
        ["final LCC"] = rule { L, c, c }
    }

    onset_rules = {
        -- plain consonant-nasal matches e.g. pneuma and knive too
        ["consonant-nasal"] = rule { false, c, n },
        ["nasal-consonant"] = rule { n, c },
        ["double nasal"] = rule { n, n },
        ["* double nasal"] = rule { false, n, n },
        ["double lingual"] = rule { L, L },
        ["liquid-lingual"] = rule { l, L },
        ["double sibilant"] = rule { s, s },
        ["too many C's (3)"] = rule { c, c, c },
        ["lingual-nasal"] = rule { l, n },
        ["CCL"] = rule { c, c, L },
        ["ClC"] = rule { c, _l, c },
        ["LC"] = rule { _n, _c },
        ["SCC"] = rule { s, c, c },
        ["SLC"] = rule { s, l, c },
        ["CCR"] = rule { _c, _c, r },
        ["CCS"] = rule { _c, _c, s },
        ["CSC"] = rule { _c, _s, c },
    }
end

---@param syl Token[]
---@return boolean, string?
local syllable_valid = function(syl)
    local vowel = find_next(syl, 1, "v")
    if not vowel then
        return false, "No vowel"
    end
    local onset = vowel - 1
    local coda = #syl - vowel
    if onset > 3 then
        return false, "Onset too long"
    elseif coda > 3 then
        return false, "Coda too long"
    end

    if onset >= 2 then
        local f, s, t = syl[1], syl[2], onset >= 3 and syl[3] or nil
        for desc, rule in pairs(onset_rules) do
            if rule(f, s, t) then
                return false, desc .. " in the onset"
            end
        end
    end

    if coda >= 2 then
        local final = syl[#syl]
        local pre = syl[#syl - 1]
        local prepre = coda >= 3 and syl[#syl - 2] or nil
        for desc, rule in pairs(coda_rules) do
            if rule(prepre, pre, final) then
                return false, desc .. " in the coda"
            end
        end
    end

    return true
end

---@param word string
---@return boolean, string?
local word_valid = function(word)
    local syllables = to_syllables(tokenize_word(word))
    for _, syl in ipairs(syllables) do
        local ok, reason = syllable_valid(syl)
        if not ok then
            return false, reason
        end
    end

    return true
end


local DEBUG = false
local MINLEN = 1
local NEGATE = false
for i, a in ipairs(arg) do
    if a == "-d" then
        DEBUG = true
    elseif a:sub(1, 2) == "-c" then
        if #a > 2 then
            MINLEN = tonumber(a:sub(3))
        else
            MINLEN = tonumber(arg[i + 1])
        end
    elseif a == "-n" then
        NEGATE = true
    end
end
if not MINLEN then
    MINLEN = 1
end

local line
repeat
    line = io.read("l")
    if not line then
        line = io.read(4096)
    end
    if line then
        for word in line:gmatch("[a-zA-Z]+") do
            if DEBUG then
                local tokens = tokenize_word(word)
                local ok, reason = word_valid(word)
                print(
                    ("\x1b[%sm%s:\x1b[0m | %s%s"):format(
                        ok and "32" or "31",
                        word,
                        table.concat(map(to_syllables(tokens), function(v)
                            return table.concat(v, "")
                        end), " "),
                        reason and " | " .. reason or ""
                    )
                )
            else
                local valid, reason = word_valid(word)
                if NEGATE then
                    if not valid then
                        print(word)
                    end
                elseif valid and #word > MINLEN then
                    print(word)
                end
            end
        end
    end
until not line
