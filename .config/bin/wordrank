#!/bin/sh

usage() {
    echo "Usage: wordrank [-l] FILE..."
    exit 1
}

while getopts ":l:n:" o; do
    case "$o" in
    l) MIN_LEN=$OPTARG ;;
    *) usage ;;
    esac
done

shift $((OPTIND - 1))

cat "$@" | tr -c '[:alnum:]' '[\n*]' |
    awk -v min="${MIN_LEN:-4}" 'length($0) > min' |
    sort |
    uniq -ci |
    sort -nr
