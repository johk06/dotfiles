#!/usr/bin/env bash

# Enumerate files matching a mimetype.
# Examples:
# - mimefind image/ -- find any image files
# - mimefind application/pdf -- find pdf files

REGEX="$1"

fd -t f "${@:2}" -X \
    file --mime-type -N -00 |
    awk -v RE="$REGEX" \
        'BEGIN { RS="\0" } NR % 2 == 1 { lastfile=$0 } NR % 2 == 0 && $0 ~ RE { print lastfile }'
