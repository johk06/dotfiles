#!/usr/bin/env bash

# Usage: side-by-side cmd1 \; cmd2 \; ... \; cmdn
# Run stdin through each command and columnate the results

FILE="$(mktemp)"
DIR="$(mktemp -d)"
trap 'rm -f "$FILE"; rm -rf "$DIR"' EXIT

cat >"$FILE"
IFS=";" read -ra CMDS <<<"$*"
cols=("$FILE")
i=0
for cmd in "${CMDS[@]}"; do
    out="$DIR/$i"
    sh -c "$cmd" <"$FILE" >"$out" &
    cols+=("$out")
    ((i++))
done
wait

paste -d $'\x1f' "${cols[@]}" | column -L -ts$'\x1f'
