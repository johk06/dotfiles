#!/usr/bin/env python

import argparse
import os
import sys
import requests
import json

APIURL = "https://api-free.deepl.com/v2/"
KEYPATH = (
    f"{os.getenv('XDG_DATA_HOME', os.getenv('HOME') + '/.local/share')}/keys/deepl"
)

with open(KEYPATH) as f:
    KEY = f.read().strip()

AUTH = f"DeepL-Auth-Key {KEY}"
HEADERS = {"Content-Type": "application/json", "Authorization": AUTH}


def request_translation(text: list[str], params: dict) -> tuple[str, str] | str:
    request = {
        "text": text,
    } | params

    res = requests.post(APIURL + "translate", headers=HEADERS, data=json.dumps(request))
    if res.ok:
        as_json = res.json()["translations"][0]
        return as_json["detected_source_language"], as_json["text"]
    else:
        return res.json()["message"]


FORMALITIES = {
    "default",
    "more",
    "prefer_more",
    "less",
    "prefer_less",
}

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "-s",
        "--source",
        metavar="LANGUAGE",
        type=str,
        dest="source",
        help="Source language (default auto)",
    )
    parser.add_argument(
        "-t",
        "--target",
        metavar="LANGUAGE",
        type=str,
        dest="target",
        default="EN",
        help="Target language (default EN)",
    )
    parser.add_argument(
        "-p",
        "--print-header",
        action="store_true",
        help="Print source and target language for each chunk",
    )
    parser.add_argument("-c", "--context", type=str, help="Provide additional context")
    parser.add_argument(
        "-f",
        "--formality",
        type=str,
        choices=FORMALITIES,
        help="Target formality level",
    )
    parser.add_argument(
        "-U",
        "--check-usage",
        action="store_true",
        help="Show used/available characters on account",
    )
    parser.add_argument(
        "-l", "--list-languages", action="store_true", help="Print available languages"
    )
    parser.add_argument("input_files", nargs="*", type=argparse.FileType("r"))
    args = parser.parse_args()

    if args.check_usage:
        response = requests.get(APIURL + "usage", headers=HEADERS)
        if response.ok:
            as_json = response.json()
            print(
                f"{as_json['character_count'] / as_json['character_limit'] * 100:.2f}%",
                as_json["character_count"],
                "of",
                as_json["character_limit"],
            )
    if args.list_languages:
        response = requests.get(APIURL + "languages", headers={"Authorization": AUTH})
        if response.ok:
            for entry in response.json():
                print(entry["language"], entry["name"])

    if args.list_languages or args.check_usage:
        exit(0)

    params = {
        "target_lang": args.target,
        "source_lang": args.source,
        "formality": args.formality,
        "context": args.context,
    }

    if not args.input_files:
        args.input_files = [sys.stdin]

    for file in args.input_files:
        while chunk := file.read():
            translation = request_translation([chunk], params)
            if type(translation) is str:
                sys.stderr.write(translation + "\n")
                exit(1)
            else:
                if args.print_header:
                    print(f"{translation[0]} -> {args.target}:")
                print(translation[1])
