include color

# mappings {{{
map R rotate rotate-ccw
map <C-l> nohlsearch
map i recolor
map go toggle_index
map <C-a> zoom in
map <C-x> zoom out

map g1 set "pages-per-row 1"
map g2 set "pages-per-row 2"
map g3 set "pages-per-row 3"
map g4 set "pages-per-row 4"
map g5 set "pages-per-row 5"

# Annotate
map A exec "xournalpp $FILE -n $PAGE"

map <Space> snap_to_page
# }}}

# options {{{
set font "FiraCode Nerd Font Mono, 12"
set show-recent 20 # annoying
set statusbar-page-percent true
set statusbar-home-tilde true
set window-title-home-tilde true
set selection-notification false
# }}}
