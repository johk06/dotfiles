# Unmap default maps i don't use {{{
map t
map w
map r
map sa
map sc
map sn
map i
map m
map za
map zh
map zn
map zr
map zs
map zt
map c
# }}}

# Options {{{
set watch
set shell zsh
# my preview script, see there for explanation
set previewer '~/.config/lf/bin/previewer.sh'
# cleanup script for kitty's image display
set cleaner '~/.config/lf/bin/cleaner.sh'
set shellopts '-ey'
set ifs "\n"
# regex is cool, generally the only exception are file extensions
# which need backslash-escaping
set filtermethod "regex"
set searchmethod "regex"
set ignorecase
set smartcase
set relativenumber
set number
# show how many files there are in dirs
set dircounts true 
set info 'size'
# message for ! commands
set waitmsg '[Press any key]'
# enable mouse
set mouse
# }}}

source "~/.config/lf/fmt.conf"
source "~/.config/lf/commands.conf"

set ratios '1:2:3'
# set the ratio dynamically
map g0 :set nopreview; set ratios '1'
map g1 :set nopreview; set ratios '1:3'
map g2 :set preview; set ratios '1:1'
map g3 :set preview; set ratios '1:2:3'
map g4 :set preview; set ratios '1:1:2:3'

# run it once so the title is displayed immediately
on-cd

# move in parent pane
map J :set dironly;updir; down;open;set dironly!
map K :set dironly;updir; up  ;open;set dironly!

# open files/dirs with enter
map <enter> open

# trash commands
map tt trash-trash
map tr trash-restore
map tDD trash-clear
# completely delete a file
map D delete

map <c-p> paste-async

# Clipboard {{{
map Yf cp-content
map Yn cp-name
map Pm push :clip-paste<space>
map Pl paste-link
map Pi clip-info
# }}}

# Renaming & Modifying {{{
map R rename
map ci :rename; cmd-home                      # change insert
map ca :rename; cmd-end                       # change append
map cn :rename; cmd-delete-home               # change name
map ce :rename; cmd-end; cmd-delete-word-back # change extension
map cb backup
map ~ backup

map cm push :chmod<space>
map co push :chown<space>
# }}}

# Change Directory {{{
map gh set hidden!
map g~ cd ~
map gt cd ~/Tmp
map gT cd ~/.local/share/Trash/files
map g/ cd /
map gc cd ~/.config
map gD cd ~/Documents/
map gw cd ~/ws
map gm cd-eval /run/media/$USER/
map gM cd-eval \$XDG_RUNTIME_DIR/gvfs
map g<space> push :cd<space>
# }}}

# Selections {{{
map u unselect
map <esc> clear
map <space>
map . :toggle
map <gt> :toggle;down
map <lt> :toggle;up
map A invert
map x push :glob-select<space>
map X push :glob-unselect<space>

map F push :select<space>
map <space>f fzf-select
map <space>/ rg-select
map <space>z zi
map z push :z<space>
# }}}

# bookmark
map M mark-save

# Sorting {{{
map st :set sortby time; set info 'time'
map sd :set sortby natural; set info size
map si :set reverse!
map sT :set sortby time; set reverse!;top;set info 'time'
map se :set sortby ext; set info
# }}}

map gl follow-link

# Make new {{{
map md push :mkdir<space>
map mf push :make-file<space>
map ml push :link<space>
map mL push :hard-link<space>
# }}}

# move to bg
map <c-z> $ kill -STOP $PPID

map <c-f> :{{
    setfilter 
    filter
}}
set incfilter true

# Stat {{{
map U disk-usage
map im info-mimetype
map id disk-usage
map ii %stat -c "%i" "$f"
map it set info "time"
map is set info "size"
map ia set info "atime"
map ib set info "btime"
map ic set info "ctime"
map iu set info "user:group"
map ip set info "user:perm"
# }}}

# Archives {{{
map az push :zip<space>
map at push :tar<space>
map ax push :extract<space>
# }}}

# Images {{{
map Is push :image-resize<space>
map Ir push :image-rotate<space>
map Im push :image-magick<space>
# }}}

# Open Externally {{{
map e
map ee &~/.config/lf/bin/split.sh none edit "$fx"
map es &~/.config/lf/bin/split.sh sp edit "$fx"
map ev &~/.config/lf/bin/split.sh vsp edit "$fx"

map rr &~/.config/lf/bin/split.sh none shell "$PWD"
map rs &~/.config/lf/bin/split.sh sp shell "$PWD"
map rv &~/.config/lf/bin/split.sh vsp shell "$PWD"

map oo &~/.config/lf/bin/split.sh none lf "$fx"
map os &~/.config/lf/bin/split.sh sp lf "$fx"
map ov &~/.config/lf/bin/split.sh vsp lf "$fx"
# }}}
