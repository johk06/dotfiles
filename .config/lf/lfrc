# Unmap default maps i don't use {{{
map t
map w
map r
map sa
map sc
map sn
map i
map m
map za
map zh
map zn
map zr
map zs
map zt
map c
# }}}

# Print and quit -- to select directories
map Q :{{
    $echo "$fx" > "/proc/$id/fd/1"
    quit
}}

# Options {{{
# Update view when files change
set watch

# My preview script, see there for explanation
set previewer '~/.config/lf/bin/previewer.sh'
set cleaner '~/.config/lf/bin/cleaner.sh' # Hide kitty imagines again

# Should be reasonably safe
set shell zsh
set ifs "\n"
set shellopts '-ey'

# Regex is cool, generally the only exception are file extensions
# which need backslash-escaping
set filtermethod "regex"
set searchmethod "regex"

# Classic
set ignorecase
set smartcase

# The holy VIM duo
set relativenumber
set number

# Show how many files there are in directories
set dircounts true 
set info 'size'

# Message for ! commands
set waitmsg '[Press any key]'
set mouse

# Quite cool
set incfilter true
# }}}

set rulerfile "~/.config/lf/ruler"
source "~/.config/lf/fmt.conf"
source "~/.config/lf/commands.conf"

# Layout {{{
set ratios '1:2:3'
# Set the ratio/preview mode dynamically
map g0 :set nopreview; set ratios '1'
map g1 :set nopreview; set ratios '1:3'
map g2 :set preview; set ratios '1:1'
map g3 :set preview; set ratios '1:2:3'
map g4 :set preview; set ratios '1:1:2:3'
# }}}

# run it once so the title is displayed immediately
on-cd

# Move in parent pane
map J :set dironly;updir; down;open;set dironly!
map K :set dironly;updir; up  ;open;set dironly!

# open files/dirs with enter
map <enter> open

# Make it behave like a proper Unix tool (the use of $ is intentional, it makes
# the redrawing of the UI work)
map <c-z> $ kill -STOP $PPID

# Trash commands
map tt trash-trash
map tr trash-restore
map tDD trash-clear

# completely delete a file
map D delete

map <c-p> paste-async

# Clipboard {{{
map Yc cp-content
map Yp cp-path
map Yn cp-name
map Yu cp-url
map Pp push :clip-paste<space>
map Pl paste-link
map Pi clip-info
# }}}
# Renaming & Modifying {{{
map R rename
map ci :rename; cmd-home                      # change insert
map ca :rename; cmd-end                       # change append
map cn :rename; cmd-delete-home               # change name
map ce :rename; cmd-end; cmd-delete-word-back # change extension
map cc :rename; cmd-end; cmd-delete-home      # change complete
map cf push :filter-name<space>
map | push :filter-name<space>
map cb backup
map ~ backup

map cm push :chmod<space>
map co push :chown<space>
# }}}
# Change Directory {{{
map gl follow-link
map gh set hidden!
map g~ cd ~
map gt cd ~/Tmp
map gT cd ~/.local/share/Trash/files
map g/ cd /
map gc cd ~/.config
map gr cd-eval \$XDG_RUNTIME_DIR
map gD cd ~/Downloads
map gw cd ~/ws
map gm cd-eval /run/media/$USER/
map gd cd /dev/disk/by-label/
map gM cd-eval \$XDG_RUNTIME_DIR/gvfs
map g<space> fzf-cd
# }}}
# Selections {{{
map u unselect
map <esc> clear
map <space>
map . :toggle
map <gt> :toggle;down
map <lt> :toggle;up
map A invert
map x push :glob-select<space>
map X push :glob-unselect<space>

# Full Glob
map * push :glob-select<space>**<left>
# Starts-With
map ^ push :glob-select<space>*<left>
# Ends-With, cannot use $ because it's already used for shell
map = push :glob-select<space>*.

map F push :select<space>
map <space>f fzf-select
map <space>/ rg-select

# Zoxide
map Z zi
map z push :z<space>
# }}}
# bookmark
map M mark-save
# Sorting {{{
map st :set sortby time; set info 'time'
map sa :set sortby atime; set info 'atime'
map sb :set sortby btime; set info 'btime'
map sc :set sortby ctime; set info 'ctime'
map sd :set sortby natural; set info size
map si :set reverse!; top
map sT :set sortby time; set reverse; top; set info 'time'
map se :set sortby ext
map sn :set sortby name
map sS :set sortby size; set info size; set reverse; top
map ss :set sortby size; set info size; set reverse false; top
map s/ :set dirfirst!
# }}}
# Stat {{{
map U disk-usage
map im info-mimetype
map id disk-usage
map ii %stat -c "%i" "$f"
map it set info "time"
map if set info "time:size"
map is set info "size"
map ia set info "atime"
map ib set info "btime"
map ic set info "ctime"
map iu set info "user:group"
map ip set info "user:perm"
# }}}
# Make new {{{
map md push :mkdir<space>
map mf push :make-file<space>
map mt push :touch-file<space>
map ml push :link<space>
map mL push :hard-link<space>
# }}}
# Archives {{{
map az push :zip<space>
map at push :tar<space>
map ax push :extract<space>
# }}}
# Images {{{
map Is push :image-resize<space>
map Ir push :image-rotate<space>
map Im push :image-magick<space>
map Iw wallpaper
# }}}

map <c-f> :{{
    setfilter 
    filter
}}
map <c-l> :{{
    setfilter 
    redraw
}}
# Filter by file extension
map . push :filter<enter>.*\.

# File systems ([b]lock devices) {{{
map bm push :block-mount<space>
map bu push :block-unmount<space>
map be push :block-eject<space>
map bd push :block-unlock<space>
map bl push :block-lock<space>
# }}}
# Open Externally {{{
map e
map ee $$EDITOR "$fx"
map es &~/.config/lf/bin/edit.sh sp "$fx"
map ev &~/.config/lf/bin/edit.sh vsp "$fx"

map rr $$SHELL
map rs split "$SHELL"
map rv vsplit "$SHELL"

map oo $lf "$fx"
map os split lf "$fx"
map ov vsplit lf "$fx"
# }}}
