# vim: ft=conf

# make sure this config file is the only thing that matters
sanitise tridactyllocal tridactylsync

set searchurls.google https://www.google.com/search?client=firefox-b-d&q=%s
set searchurls.g google
set searchurls.scholar https://scholar.google.com/scholar?hl=en&as_sdt=0%2C5&q=%s&btnG=
set searchurls.gs scholar
set searchurls.youtube https://www.youtube.com/results?search_query=%s
set searchurls.yt youtube
set searchurls.github https://github.com/search?q=%s
set searchurls.gh github
set searchurls.wiktionary https://en.wiktionary.org/w/index.php?search=%s
set searchurls.wd wiktionary
set searchurls.wikipedia https://en.wikipedia.org/w/index.php?search=%s
set searchurls.wk wikipedia

set modeindicator true
set editorcmd kitty -- nvim %f +%l 
set hintuppercase false
set hintautoselect true
set smoothscroll true

bind j scrollline 5
bind k scrollline -5

# somehow ironic given that I do not use those keys in vim
bind --mode=normal ' gobble 1 markjump
bind --mode=normal m gobble 1 markadd

colorscheme jhk

bind J tabnext
bind K tabprev
bind I focusinput -I

unbind <C-c>
unbind --mode=visual <C-c>
unbind <C-[>
unbind <F1>

bind / fillcmdline find
bind ? fillcmdline find -?
bind n findnext 1
bind n findnext -1
bind <C-l> nohlsearch

bind --mode=input <C-c> composite unfocus | mode normal
bind --mode=ex <C-c> ex.hide_and_clear
bind --mode=hint <C-c> hint.reset
bind --mode=normal * tabduplicate

unbind H
unbind L
bind H back
bind L forward

bind n findnext 1
bind N findnext -1

unbind <C-f>
unbind d
bind dd tabclose
bind --mode=input <C-x> editor
