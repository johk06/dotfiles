[options]
background = 2e3440
overlay = true
overlay_position_bottom = true
overlay_font = Fira Code:11
overlay_text_color = eceff4
overlay_background_color = 2e3440
overlay_background_alpha = f0

# Suppress built-in key bindings, and specify them explicitly in this
# config file.
suppress_default_binds = true

[aliases]
# Define aliases here. Any arguments passed to an alias are appended to the
# command.
# alias = command to run

[binds]
q = quit

d = close

# Image navigation
<Left> = prev
<bracketleft> = prev
<Right> = next
<bracketright> = next
gg = goto 1
<Shift+G> = goto -1

# Panning
j = pan 0 -50
k = pan 0 50
h = pan 50 0
l = pan -50 0


# Zooming
<Up> = zoom 1
<Shift+plus> = zoom 1
<Down> = zoom -1
<minus> = zoom -1
i = zoom 1
o = zoom -1
zz = zoom actual

# Rotate Clockwise by 90 degrees
<Ctrl+r> = rotate by 90

# Other commands
f = fullscreen
<Shift+I> = overlay
p = exec echo $imv_current_file
c = center
s = scaling next
<Shift+S> = upscaling next
a = zoom actual
r = reset

# Gif playback
<period> = next_frame
<space> = toggle_playing

# Slideshow control
t = slideshow +1
<Shift+T> = slideshow -1

