# vim: set ft=xcompose :

<Multi_key> <i> <n> : "∈" U2208
<Multi_key> <exclam> <i> <n> : "∉" U2209

# Set operations, using { as a leader {{{
<Multi_key> <braceleft> <parenleft> : "⊂" U2282
<Multi_key> <braceleft> <equal> <parenleft> : "⊆" U2286

<Multi_key> <braceleft> <parenright> : "⊃" U2283
<Multi_key> <braceleft> <equal> <parenright> : "⊇" U2284

<Multi_key> <braceleft> <u> : "∪" U222a
<Multi_key> <braceleft> <n> : "∩" U2229
<Multi_key> <braceleft> <U> : "⋃" U22c3
<Multi_key> <braceleft> <N> : "⋂" U22c2
# }}}

<Multi_key> <n> <o> <t> : "¬" U00ac
# like programming languages
<Multi_key> <ampersand> <ampersand> : "∧" U2229
<Multi_key> <bar> <bar> : "∨" U2228
<Multi_key> <a> <l> <l> : "∀" U2200
<Multi_key> <e> <x> : "∃" U2203
<Multi_key> <exclam> <e> <x> : "∄" U2204


# Summation/Product: Repeat the operator
<Multi_key> <plus> <plus> : "∑" U2211 # NOTE: No-One needs a digraph for `#`
<Multi_key> <asterisk> <asterisk> : "∏" U220f

# Integrals
<Multi_key> <I> <n> : "∫"  U222b
<Multi_key> <I> <2> <n> : "∬ "  U222c
<Multi_key> <I> <3> <n> : "∭"  U222d
<Multi_key> <I> <o> <n> : "∮" U222e
