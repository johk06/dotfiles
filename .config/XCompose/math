# vim: set ft=xcompose :

# Sets {{{
<Multi_key> <i> <n> : "∈" U2208
<Multi_key> <exclam> <i> <n> : "∉" U2209

<Multi_key> <braceleft> <parenleft> : "⊂" U2282
<Multi_key> <braceleft> <equal> <parenleft> : "⊆" U2286

<Multi_key> <braceleft> <parenright> : "⊃" U2283
<Multi_key> <braceleft> <equal> <parenright> : "⊇" U2284

<Multi_key> <braceleft> <u> : "∪" U222a
<Multi_key> <braceleft> <n> : "∩" U2229
<Multi_key> <braceleft> <U> : "⋃" U22c3
<Multi_key> <braceleft> <N> : "⋂" U22c2
# }}}
# Logic {{{
<Multi_key> <l> <asciitilde> : "¬" U00ac
<Multi_key> <l> <ampersand> : "∧" U2229
<Multi_key> <l> <bar>  : "∨" U2228
<Multi_key> <l> <asciicircum> : "⊻" U22bb
<Multi_key> <exclam> <ampersand> : "⊼" U2229
<Multi_key> <a> <l> <l> : "∀" U2200
<Multi_key> <e> <x> : "∃" U2203
<Multi_key> <exclam> <e> <x> : "∄" U2204
# }}}
# Operators {{{
# Summation/Product: Repeat the binary operator
<Multi_key> <plus> <plus> : "∑" U2211 # NOTE: This overrides the digraph for #, which no-one ever needs
<Multi_key> <asterisk> <asterisk> : "∏" U220f

# Integrals
<Multi_key> <I> <n> : "∫"  U222b
<Multi_key> <I> <2> <n> : "∬ "  U222c
<Multi_key> <I> <3> <n> : "∭"  U222d
<Multi_key> <I> <o> <n> : "∮" U222e
# }}}
# Geometry {{{
<Multi_key> <bar> <bar> : "∥" U2225
<Multi_key> <exclam> <bar> <bar> : "∦" U2226
<Multi_key> <bar> <underscore> : "⟂" U27C2
<Multi_key> <slash> <underscore> : "∠" U2220
<Multi_key> <slash> <o> <underscore> : "∡" U2221
# }}}
