# archaic greek letters, double @
# digamma
<Multi_key> <asterisk> <asterisk> <w> : "ϝ"
<Multi_key> <asterisk> <asterisk> <W> : "Ϝ"
# qoppa
<Multi_key> <asterisk> <asterisk> <q> : "ϙ"
<Multi_key> <asterisk> <asterisk> <Q> : "Ϙ"
# san
<Multi_key> <asterisk> <asterisk> <s> : "ϻ"
