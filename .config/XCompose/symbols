# vim: ft=xcompose

# currencies
<Multi_key> <dollar> <e> : "€"
<Multi_key> <dollar> <y> : "¥"
<Multi_key> <dollar> <l> : "£"
<Multi_key> <dollar> <r> : "₽"
<Multi_key> <dollar> <h> : "₴"
<Multi_key> <dollar> <d> : "₫"
<Multi_key> <dollar> <i> : "₹"
<Multi_key> <dollar> <w> : "₩"

# punctuation 
# tironian et
<Multi_key> <ampersand> <7> : "⁊"

# Combining diacritics, like the regular ones with a space {{{
<Multi_key> <grave> <space> : "̀"
<Multi_key> <apostrophe> <space> : "́"
<Multi_key> <asciicircum> <space> : "̂"
<Multi_key> <asciitilde> <space> : "̂"
<Multi_key> <minus> <space> : "̄"
<Multi_key> <underscore> <space> : "̅"
<Multi_key> <b> <space> : "̆"
<Multi_key> <colon> <space> : "̈"
<Multi_key> <o> <space> : "̊"
# }}}
